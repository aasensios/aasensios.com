---
import { Image } from "astro:assets";
import type { SvgComponent } from "astro/types";
import Moon from "../assets/icons/moon.svg";
import Sun from "../assets/icons/sun.svg";
import Layout from "@layouts/layout.astro";
import avatar from "../assets/avatar.jpg";
import { site } from "../content/site";
import { formatPeriodMonths, toYearMonth, yearsSince } from "../lib/dates";
import { axisYears, barPosition, trackPath } from "../lib/timeline";

const now = toYearMonth(new Date());
const copy = site.copy;
const years = yearsSince(site.firstJobStart, now);
const axis = axisYears(site.firstJobStart.year, now);
const logos = import.meta.glob<SvgComponent>("../assets/logos/*.svg", {
  eager: true,
  import: "default",
});
const logo = (file: string) => logos[`../assets/logos/${file}`];
/* Career line geometry, in viewBox units: x is percent of the axis, y is pixels of a lane. */
const LANE = 36;
const CURVE = 1.2;
/* The line draws itself at a steady pace through time, from the first job to today. */
const first = site.experience.at(-1)!;
const origin = barPosition(first.start, first.end, site.firstJobStart.year, now).left - CURVE * 2;
const span = 100 - origin;
const GLINT_W = 8;
const GLINT_H = 3;
const at = (x: number) => Math.max(0, (x - origin) / span).toFixed(4);
---

<Layout
  title={site.name}
  description="Frontend-focused product engineer. I make screens you can leave: the best interfaces get you what you need, then let you go."
>
  <div class="page">
    <div class="wrap">
      <header class="head">
        <button type="button" class="avatar-open" aria-label={copy.avatar.open} data-avatar-open>
          <Image
            class="avatar"
            src={avatar}
            alt=""
            width={56}
            height={56}
            densities={[1, 2]}
            loading="eager"
          />
        </button>
        <dialog class="portrait" aria-label={site.name} closedby="any" data-avatar-dialog>
          <Image class="portrait-img" src={avatar} alt={site.name} width={256} height={256} />
          <form method="dialog">
            <button type="submit" class="portrait-close" aria-label={copy.avatar.close}>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </button>
          </form>
        </dialog>
        <span class="scheme">
          <button type="button" aria-label={copy.theme.label} aria-pressed="false" data-theme-toggle>
            <span class="sky">
            <span class="body sun">
              <Sun aria-hidden="true" />
            </span>
            <span class="body moon">
              <Moon aria-hidden="true" />
            </span>
            </span>
          </button>
          <span class="tip" aria-hidden="true">
            <span class="light-only">{copy.theme.toDark}</span>
            <span class="dark-only">{copy.theme.toLight}</span>
          </span>
        </span>
      </header>

      <main>
        <p class="byline">{site.name}</p>
        <h1>{copy.headline}</h1>
        {copy.intro.map((p) => <p>{p}</p>)}
        <p>{copy.facts(years)}</p>

        <section>
          <h2>{copy.sections.experience}</h2>
          <ul>
            {
              site.experience.map((e) => (
                <li class="row">
                  <span class="title">
                    {e.role} at{" "}
                    <a href={e.url} target="_blank" rel="noopener">
                      {e.company}
                    </a>
                    {e.client && (
                      <>
                        {" "}
                        for{" "}
                        <a href={e.client.url} target="_blank" rel="noopener">
                          {e.client.name}
                        </a>
                      </>
                    )}
                  </span>
                  <span class="meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                </li>
              ))
            }
          </ul>
          <div
            class="chart"
            style={`--years:${axis.length};--lane:${LANE}px;--origin:${origin.toFixed(3)}%`}
            data-chart
          >
            <button
              type="button"
              class="chart-pause"
              aria-label={copy.chart.pause}
              aria-pressed="false"
              data-chart-pause
            >
              <svg class="icon-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M5.5 3.5v9M10.5 3.5v9" />
              </svg>
              <svg class="icon-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M5 3.5v9l7.5-4.5z" />
              </svg>
            </button>
            <div class="grid" aria-hidden="true">
              {axis.map(() => (
                <span />
              ))}
            </div>
            <ul class="lanes" aria-hidden="true">
              {
                site.experience.map((e, i) => {
                  const later = site.experience[i - 1];
                  const earlier = site.experience[i + 1];
                  const { left, width } = barPosition(
                    e.start,
                    e.end,
                    site.firstJobStart.year,
                    now,
                    later?.start,
                  );
                  const d = trackPath(left, width, {
                    mid: LANE / 2,
                    rise: earlier ? LANE : undefined,
                    curve: CURVE,
                    continues: Boolean(later),
                  });
                  const Logo = logo(e.logo);
                  return (
                    <li
                      class="lane"
                      style={`--left:${left}%;--width:${width}%;--brand:${e.color};--brand-dark:${e.colorDark ?? e.color};--stop-at:${at(left)}`}
                    >
                      <svg class="track" viewBox={`0 0 100 ${LANE}`} preserveAspectRatio="none">
                        <path d={d} />
                        {!e.end && (
                          <>
                            <defs>
                              <linearGradient id="glint">
                                <stop offset="0" stop-color="#fff" stop-opacity="0" />
                                <stop offset="0.5" stop-color="#fff" stop-opacity="0.85" />
                                <stop offset="1" stop-color="#fff" stop-opacity="0" />
                              </linearGradient>
                            </defs>
                            <rect
                              class="glint"
                              x={left}
                              y={LANE / 2 - GLINT_H / 2}
                              width={GLINT_W}
                              height={GLINT_H}
                              fill="url(#glint)"
                              style={`--run:${(width - GLINT_W).toFixed(3)}`}
                            />
                          </>
                        )}
                      </svg>
                      <span class="stop" />
                      {!e.end && <span class="now" />}
                      <span class="card">
                        <span class="card-logo">
                          <Logo width={20} height={20} aria-hidden="true" />
                        </span>
                        <span class="card-text">
                          <span class="card-title">
                            {e.role} at {e.company}
                            {e.client && ` for ${e.client.name}`}
                          </span>
                          <span class="card-meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                        </span>
                      </span>
                    </li>
                  );
                })
              }
            </ul>
            <div class="axis" aria-hidden="true">
              {axis.map((y) => (
                <span>{y}</span>
              ))}
            </div>
          </div>
        </section>

        <section>
          <h2>{copy.sections.projects}</h2>
          <ul>
            {
              site.projects.map((p) => (
                <li>
                  <a class="row" href={p.repo} target="_blank" rel="noopener">
                    <span class="title">{p.title}</span>
                    <span class="meta">{p.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{copy.sections.links}</h2>
          <p class="links">
            {
              site.links.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">/</span>}
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                </>
              ))
            }
          </p>
        </section>
      </main>

      <footer>
        {
          copy.footer.map((f) => (
            <>
              {f.label}{" "}
              <a href={f.link.href} target="_blank" rel="noopener">
                {f.link.label}
              </a>
            </>
          ))
        }
      </footer>
    </div>
  </div>
</Layout>

<script>
  /* The line draws itself once the chart is on screen, and the button pauses it and the pulse. */
  const chart = document.querySelector<HTMLElement>("[data-chart]");
  const pause = chart?.querySelector<HTMLButtonElement>("[data-chart-pause]");
  if (chart) {
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        chart.toggleAttribute("data-seen", true);
        observer.disconnect();
      },
      { threshold: 0.4 },
    ).observe(chart);
  }
  pause?.addEventListener("click", () => {
    const paused = chart!.toggleAttribute("data-paused");
    pause.setAttribute("aria-pressed", String(paused));
  });

  /* On touch screens a tap opens a lane's card; tapping it again or anywhere else closes it. */
  if (!matchMedia("(hover: hover)").matches) {
    const lanes = [...document.querySelectorAll<HTMLElement>(".lane")];
    addEventListener("click", (event) => {
      const hit = (event.target as Element).closest<HTMLElement>(".lane");
      for (const lane of lanes) lane.toggleAttribute("data-open", lane === hit && !lane.hasAttribute("data-open"));
    });
  }

  const portrait = document.querySelector<HTMLDialogElement>("[data-avatar-dialog]");
  document.querySelector("[data-avatar-open]")?.addEventListener("click", () => portrait?.showModal());
  /* Clicking the photo or the backdrop zooms back out, like the close button. */
  portrait?.addEventListener("click", () => portrait.close());

  const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
  const sky = toggle?.querySelector<HTMLElement>(".sky");
  if (
    toggle &&
    sky &&
    matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches
  ) {
    toggle.addEventListener("pointermove", (event) => {
      const box = sky.getBoundingClientRect();
      const tx = ((event.clientX - box.left) / box.width - 0.5) * 2;
      const ty = ((event.clientY - box.top) / box.height - 0.5) * 2;
      sky.style.setProperty("--tx", String(Math.max(-1, Math.min(1, tx))));
      sky.style.setProperty("--ty", String(Math.max(-1, Math.min(1, ty))));
    });
    toggle.addEventListener("pointerleave", () => {
      sky.style.removeProperty("--tx");
      sky.style.removeProperty("--ty");
    });
  }
</script>


<style>
  .page {
    /* Color */
    --bg: light-dark(#faf7f0, #0e131b); /* Background */
    --fg: light-dark(#231f17, #dfe6f1); /* Foreground */
    --muted: light-dark(#756b57, #909fb6);
    --rule: light-dark(#e7e1d5, #252d39);
    --logo-bg: light-dark(#fff, #dfe6f1);

    /* Font face */
    --font: "Inter Variable", system-ui, sans-serif;
    --font-heading: "Averia Serif Libre", Georgia, serif;

    /* Font size scale: Minor Third (factor of 1.2) - typescale.com */
    --text-display: 2.986rem; /* h1 */
    --text-body: 1rem; /* p */
    --text-caption: 0.833rem; /* small */
    --text-micro: 0.694rem;

    /* Vertical rhythm: open leading for text, tight for headings */
    --leading-text: 1.6;
    --leading-heading: 1.2;
    --weight-regular: 400;
    --weight-bold: 700;
    --opsz-regular: 14;
    --opsz-bold: 25;

    /* Spacing on a 4px grid */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;
    --space-12: 48px;
    --space-14: 56px;
    --space-16: 64px;
    /* Space between blocks: body line height / 1.5, on the 4px grid */
    --flow: var(--space-4);
    /* Space before a section heading: twice the flow, three times on wider screens */
    --section-gap: calc(var(--flow) * 2);

    /* Lines */
    --hairline: 1px solid var(--rule);
    --focus-ring: 1px solid var(--fg);
    --focus-offset: 2px;
    --underline: 1px;
    --underline-hover: 2px;
    --underline-offset: 3px;

    /* Shape */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 16px;

    /* Sizes */
    --measure: 640px;
    --avatar: 56px;
    --portrait: 256px;
    --tap: 64px;
    --icon: 56px;
    --popover: 240px;

    /* Motion */
    --duration: 150ms;
    --ease: ease-out;

    position: relative;
    isolation: isolate;
    overflow-x: clip;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    font-variation-settings: "opsz" var(--opsz-regular);
    font-weight: var(--weight-regular);
    font-synthesis: none;
    font-size: var(--text-body);
    line-height: var(--leading-text);
  }
  .page ::selection {
    background: var(--fg);
    color: var(--bg);
  }
  .page a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-10) var(--space-5) var(--space-12);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 30%;
    corner-shape: squircle;
  }
  .avatar-open {
    border-radius: 30%;
    corner-shape: squircle;
    cursor: zoom-in;
  }
  .avatar-open:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* The dialog sits in the top layer, so it carries its own colours from the page tokens. */
  .portrait {
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: var(--fg);
  }
  .portrait::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(4px);
  }
  .portrait-img {
    width: min(var(--portrait), calc(100vw - var(--space-10)));
    height: auto;
    border-radius: 30%;
    corner-shape: squircle;
    cursor: zoom-out;
  }
  .portrait-close {
    position: absolute;
    top: calc(var(--space-2) * -1);
    right: calc(var(--space-2) * -1);
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    border: var(--hairline);
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }
  .portrait-close:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  @media (prefers-reduced-motion: no-preference) {
    .portrait,
    .portrait::backdrop {
      transition:
        opacity var(--duration) var(--ease),
        scale var(--duration) var(--ease),
        overlay var(--duration) allow-discrete,
        display var(--duration) allow-discrete;
      opacity: 0;
    }
    .portrait {
      scale: 0.96;
    }
    .portrait[open],
    .portrait[open]::backdrop {
      opacity: 1;
      scale: 1;
    }
    @starting-style {
      .portrait[open],
      .portrait[open]::backdrop {
        opacity: 0;
      }
      .portrait[open] {
        scale: 0.96;
      }
    }
  }

  .byline {
    margin-top: var(--section-gap);
  }
  /* Quiet labels: the byline and section headings step back so the text leads. */
  .byline,
  h2 {
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
  }
  h1 {
    margin-top: var(--space-1);
    font-family: var(--font-heading);
    font-size: var(--text-display);
    line-height: var(--leading-heading);
    font-weight: var(--weight-bold);
    font-variation-settings: "opsz" var(--opsz-bold);
  }
  p {
    margin-top: var(--flow);
  }
  section,
  footer {
    margin-top: var(--section-gap);
  }
  ul {
    margin-top: var(--flow);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: var(--hairline);
  }
  li.row:last-child,
  li:last-child > a.row {
    border-bottom: 0;
  }
  .title {
    min-width: 0;
  }
  .meta {
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
    white-space: nowrap;
  }

  /* The table above carries the same facts, so the chart is aria-hidden. */
  .chart {
    --stroke: 3px;
    --stop: 12px;
    --logo: 28px;
    --logo-mark: 20px;
    --axis: 32px;
    --dimmed: 0.3;
    --inset-x: var(--space-3);
    --inset-y: var(--space-2);

    position: relative;
    margin-top: var(--flow);
    padding: var(--inset-y) var(--inset-x) 0;
    border: var(--hairline);
    border-radius: var(--radius-xl);
    corner-shape: squircle;
  }
  .grid {
    position: absolute;
    inset: 0 var(--inset-x);
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
  }
  .grid span + span {
    border-left: 1px dashed var(--rule);
  }
  .lanes {
    position: relative;
    margin-top: 0;
  }
  .lane {
    --line: light-dark(var(--brand), var(--brand-dark));

    position: relative;
    height: var(--lane);
  }
  /* Stretched to the lane so x maps to time; the stroke keeps its width regardless. */
  .track {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .track path {
    fill: none;
    stroke: var(--line);
    stroke-width: var(--stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .stop,
  .now {
    position: absolute;
    top: 50%;
    width: var(--stop);
    height: var(--stop);
    border-radius: 50%;
    translate: -50% -50%;
  }
  .stop {
    left: var(--left);
    border: var(--stroke) solid var(--line);
    background: var(--bg);
  }
  .now {
    left: calc(var(--left) + var(--width));
    background: var(--line);
    box-shadow: 0 0 0 var(--stroke) var(--bg);
  }
  .lanes:has(.lane:is(:hover, [data-open])) .lane:not(:hover, [data-open]) :is(.track, .stop, .now) {
    opacity: var(--dimmed);
  }
  .lane:is(:hover, [data-open]) {
    z-index: 2;
  }
  .card {
    position: absolute;
    top: calc(var(--lane) - var(--space-1));
    left: clamp(0px, calc(var(--left) - var(--space-4)), calc(100% - var(--popover)));
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: max-content;
    max-width: var(--popover);
    padding: var(--space-2) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--bg);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .card-logo {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--logo);
    height: var(--logo);
    overflow: hidden;
    border-radius: var(--radius-md);
    corner-shape: squircle;
    background: var(--logo-bg);
    box-shadow: 0 0 0 1px var(--rule);
  }
  .card-logo svg {
    width: var(--logo-mark);
    height: var(--logo-mark);
  }
  .card-text {
    display: grid;
  }
  /* Touch screens keep :hover after a tap, so taps toggle data-open instead. */
  @media (hover: hover) {
    .lane:hover .card {
      visibility: visible;
      opacity: 1;
    }
  }
  .lane[data-open] .card {
    visibility: visible;
    opacity: 1;
  }
  .card-meta {
    color: var(--muted);
  }
  .chart-pause {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 3;
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    border-radius: 50%;
    color: var(--muted);
    cursor: pointer;
  }
  .chart-pause:hover,
  .chart-pause:focus-visible {
    color: var(--fg);
  }
  .chart-pause:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .chart-pause path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chart-pause .icon-play path {
    fill: currentColor;
  }
  .chart-pause[aria-pressed="true"] .icon-pause,
  .chart-pause[aria-pressed="false"] .icon-play {
    display: none;
  }
  .axis {
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
    height: var(--axis);
    align-items: center;
    color: var(--muted);
    font-size: var(--text-micro);
    line-height: var(--leading-text);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .track,
    .stop,
    .now {
      transition: opacity var(--duration) var(--ease);
    }
    .card {
      transition:
        opacity var(--duration) var(--ease),
        visibility 0s var(--duration);
    }
    .lane:is(:hover, [data-open]) .card {
      transition: opacity var(--duration) var(--ease);
    }

    /*
     * One pen draws the whole career at a steady pace: the lanes are wiped in from the first
     * job to today, since x is time. Stops pop in as the pen passes them; then today's dot
     * keeps breathing and a glint of light runs along the current job.
     * (A stroke-dash draw doesn't work here: non-scaling strokes break dash lengths.)
     */
    .chart {
      --draw: 2800ms;
      --breath: 2400ms;
    }
    .lanes {
      animation: wipe var(--draw) linear backwards;
    }
    .glint {
      animation: glint var(--breath) var(--daybreak-ease) var(--draw) infinite both;
    }
    .stop {
      animation: pop 300ms var(--ease) calc(var(--stop-at) * var(--draw)) both;
    }
    .now {
      animation: pop 300ms var(--ease) var(--draw) both;
    }
    .now::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--line);
      animation: breathe var(--breath) var(--ease) var(--draw) infinite both;
    }
    /* Hold everything at the start until the chart scrolls into view; without JS it just runs. */
    :global(:root[data-js]) .chart:not([data-seen]) :is(.lanes, .glint, .stop, .now),
    :global(:root[data-js]) .chart:not([data-seen]) .now::after,
