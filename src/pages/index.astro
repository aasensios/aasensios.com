---
import { Image } from "astro:assets";
import type { SvgComponent } from "astro/types";
import Moon from "../assets/icons/moon.svg";
import Sun from "../assets/icons/sun.svg";
import Layout from "@layouts/layout.astro";
import avatar from "../assets/avatar.jpg";
import { gifSizes } from "../content/gif-sizes";
import { site, type DayGif } from "../content/site";
import { formatMonthRange, formatPeriod, toYearMonth, yearsSince } from "../lib/dates";
import { gifAnimated, gifStill } from "../lib/gif";
import { previewName } from "../lib/preview";
import { barPosition, yearSpans } from "../lib/timeline";

const now = toYearMonth(new Date());
const copy = site.copy;
const years = yearsSince(site.firstJobStart, now);
const axis = yearSpans(site.firstJobStart, now);
const logos = import.meta.glob<SvgComponent>("../assets/logos/*.svg", {
  eager: true,
  import: "default",
});
const logo = (file: string) => logos[`../assets/logos/${file}`];
const shots = import.meta.glob<ImageMetadata>("../assets/previews/*.jpeg", {
  eager: true,
  import: "default",
});
const previews = new Map(
  Object.entries(shots).map(([path, src]) => [path.split("/").at(-1)!.replace(".jpeg", ""), src]),
);
const preview = (url: string) => (previews.has(previewName(url)) ? previewName(url) : undefined);
/*
 * Memes are CSS backgrounds, not <img>s: browsers never fetch a background for an element
 * that isn't rendered, so only today's meme in the current theme is downloaded.
 */
const themes = ["light", "dark"] as const;
/* The gallery runs Monday to Sunday, one GIF per slide: each button's day pet, then night pet. */
const slides = [1, 2, 3, 4, 5, 6, 0].flatMap((day) =>
  site.links.flatMap((l) =>
    themes.map((theme) => ({
      day,
      theme,
      tag: l.tag,
      id: l.gifs[day][theme],
      key: `${copy.pack.days[day]} · ${copy.pack.themes[theme]} · ${l.tag}`,
      alt: `A ${theme === "light" ? "dog" : "cat"} ${l.meme}`,
    })),
  ),
);
/* The GIF review tools only exist on the dev server, never in the built site. */
const review = import.meta.env.DEV;
const gifVars = (day: DayGif) =>
  [
    `--still-light:url(${gifStill(day.light)})`,
    `--still-dark:url(${gifStill(day.dark)})`,
    `--play-light:url(${gifAnimated(day.light)})`,
    `--play-dark:url(${gifAnimated(day.dark)})`,
    `--ratio-light:${gifSizes[day.light].join("/")}`,
    `--ratio-dark:${gifSizes[day.dark].join("/")}`,
  ].join(";");
const place = (e: (typeof site.experience)[number], i: number) =>
  barPosition(e.start, e.end, site.firstJobStart, now, site.experience[i - 1]?.start);
---

<Layout
  title={site.name}
  description="Frontend-focused product engineer. I make screens you can leave: the best interfaces get you what you need, then let you go."
>
  <div class="page">
    <div class="wrap">
      <header class="head">
        <button type="button" class="avatar-open" aria-label={copy.avatar.open} data-avatar-open>
          <Image
            class="avatar"
            src={avatar}
            alt=""
            width={56}
            height={56}
            densities={[1, 2]}
            loading="eager"
          />
        </button>
        <dialog class="portrait" aria-label={site.name} closedby="any" data-avatar-dialog>
          <Image class="portrait-img" src={avatar} alt={site.name} width={256} height={256} />
          <form method="dialog">
            <button type="submit" class="portrait-close" aria-label={copy.avatar.close}>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </button>
          </form>
        </dialog>
        <span class="scheme">
          <button type="button" aria-label={copy.theme.label} aria-pressed="false" data-theme-toggle>
            <span class="sky">
            <span class="body sun">
              <Sun aria-hidden="true" />
            </span>
            <span class="body moon">
              <Moon aria-hidden="true" />
            </span>
            </span>
          </button>
          <span class="tip" aria-hidden="true">
            <span class="light-only">{copy.theme.toDark}</span>
            <span class="dark-only">{copy.theme.toLight}</span>
          </span>
        </span>
      </header>

      <main>
        <p class="byline">{site.name}</p>
        <h1>{copy.headline}</h1>
        {copy.intro.map((p) => <p>{p}</p>)}
        <p>{copy.facts(years)}</p>

        <section>
          <h2>{copy.sections.experience}</h2>
          <div class="chart">
            <div class="grid" aria-hidden="true">
              {axis.slice(1).map((y) => (
                <span style={`--left:${y.left}%`} />
              ))}
            </div>
            <div class="plot" aria-hidden="true">
              <ul class="lanes">
                {
                  site.experience.map((e, i) => {
                    const { left, width } = place(e, i);
                    const Logo = logo(e.logo);
                    return (
                      <li
                        class="lane"
                        style={`--left:${left}%;--width:${width}%;--brand:${e.color};--brand-dark:${e.colorDark ?? e.color}`}
                      >
                        <span class="segment" />
                        <span class="card">
                          <span class="card-logo">
                            <Logo width={20} height={20} aria-hidden="true" />
                          </span>
                          <span class="card-text">
                            <span class="card-title">
                              {e.role} at {e.company}
                              {e.client && ` for ${e.client.name}`}
                            </span>
                            <span class="card-meta">{formatMonthRange(e.start, e.end, now)}</span>
                          </span>
                        </span>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
            <div class="axis" aria-hidden="true">
              {axis.map((y) => (
                <span style={`--left:${y.left + y.width / 2}%`}>{y.year}</span>
              ))}
            </div>
          </div>
          <ul>
            {
              site.experience.map((e) => (
                <li class="row">
                  <span class="title">
                    {e.role} at{" "}
                    <a href={e.url} target="_blank" rel="noopener" data-preview={preview(e.url)}>
                      {e.company}
                    </a>
                    {e.client && (
                      <>
                        {" "}
                        for{" "}
                        <a
                          href={e.client.url}
                          target="_blank"
                          rel="noopener"
                          data-preview={preview(e.client.url)}
                        >
                          {e.client.name}
                        </a>
                      </>
                    )}
                  </span>
                  <span class="meta">{formatPeriod(e.start, e.end, now)}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{copy.sections.projects}</h2>
          <ul>
            {
              site.projects.map((p) => (
                <li>
                  <a class="row" href={p.repo} target="_blank" rel="noopener">
                    <span class="title">{p.title}</span>
                    <span class="meta">{p.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <p class="links">
            {
              site.links.map((l) => (
                <a class="cta" href={l.href} target="_blank" rel="noopener">
                  <span class="cta-gif" aria-hidden="true">
                    {l.gifs.map((day, d) => (
                      <span class={`shot day day-${d}`} style={gifVars(day)} />
                    ))}
                  </span>
                  <span class="cta-card" aria-hidden="true">
                    {l.gifs.map((day, d) => (
                      <span class={`shot day day-${d}`} style={gifVars(day)} />
                    ))}
                  </span>
                  {l.label}
                </a>
              ))
            }
          </p>
          <p class="pack-open-row">
            <button type="button" class="pack-open" data-pack-open>
              <span class="family" aria-hidden="true">
                {site.links.flatMap((l) =>
                  themes.map((theme) => (
                    <span class="pet">
                      {l.gifs.map((day, d) => (
                        <span class={`face day day-${d}`} style={`--face:url(${gifStill(day[theme])})`} />
                      ))}
                    </span>
                  )),
                )}
              </span>
              {copy.pack.open}
            </button>
          </p>
          <dialog class="pack" aria-labelledby="pack-title" data-pack>
            <header class="pack-head">
              <div>
                <h2 id="pack-title" class="pack-title">{copy.pack.title}</h2>
                <p class="pack-lede">{copy.pack.lede}</p>
              </div>
              <form method="dialog">
                <button type="submit" class="dialog-close" aria-label={copy.pack.close}>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path
                      d="M4 4l8 8M12 4l-8 8"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
              </form>
            </header>
            <div class="pack-stories" role="group" aria-label={copy.pack.title}>
              {slides.map((s, i) => (
                <button type="button" aria-label={s.key} data-pack-story={i} />
              ))}
            </div>
            <div class="pack-viewport">
              <div class="pack-track" data-pack-track></div>
              <span class="pack-copied" role="status" data-pack-copied />
            </div>
            <div class="pack-foot">
              <p class="pack-caption" data-pack-caption></p>
              <nav class="pack-nav">
                <button type="button" aria-label={copy.pack.prev} data-pack-prev>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M10 3.5 5.5 8l4.5 4.5" />
                  </svg>
                </button>
                <button type="button" aria-label={copy.pack.next} data-pack-next>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="m6 3.5 4.5 4.5L6 12.5" />
                  </svg>
                </button>
              </nav>
            </div>
            <div class="pack-actions">
              <button type="button" data-copy-link data-done={copy.pack.copiedLink}>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M6.5 9.5l3-3M7 4.5l1-1a2.5 2.5 0 0 1 3.5 3.5l-1 1M9 11.5l-1 1A2.5 2.5 0 0 1 4.5 9l1-1" />
                </svg>
                {copy.pack.copyLink}
              </button>
              <button type="button" data-copy-gif data-done={copy.pack.copiedGif}>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M5.5 5.5V3.5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2M3.5 5.5h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1z" />
                </svg>
                {copy.pack.copyGif}
              </button>
            </div>
            <template data-pack-items>
              {slides.map((s) => (
                <section
                  class="pack-slide"
                  data-key={s.key}
                  data-day={s.day}
                  data-theme={s.theme}
                  data-tag={s.tag}
                >
                  <div class="pack-stage">
                    <div class="pack-gif" data-gif={s.id}>
                      <picture>
                        <source
                          media="(prefers-reduced-motion: no-preference)"
                          srcset={gifAnimated(s.id)}
                          type="image/webp"
                        />
                        <img
                          src={gifStill(s.id)}
                          alt={s.alt}
                          width={gifSizes[s.id][0]}
                          height={gifSizes[s.id][1]}
                          loading="lazy"
                          crossorigin="anonymous"
                        />
                      </picture>
                    </div>
                  </div>
                </section>
              ))}
            </template>
            {
              review && (
                <footer class="pack-dev" data-suggest data-none={copy.pack.review.none}>
                  <span class="pack-dev-badge">{copy.pack.review.badge}</span>
                  <span class="pack-dev-actions">
                    <button type="button" data-suggest-cancel hidden>
                      {copy.pack.review.cancel}
                    </button>
                    <button type="button" data-suggest-next data-again={copy.pack.review.another}>
                      {copy.pack.review.suggest}
                    </button>
                    <button type="button" data-suggest-use hidden>
                      {copy.pack.review.use}
                    </button>
                  </span>
                </footer>
              )
            }
          </dialog>
        </section>
      </main>

      <div class="site-preview" aria-hidden="true" data-preview-card>
        <span class="site-preview-shot">
          {
            [...previews].map(([name, src]) => (
              <Image
                src={src}
                alt=""
                width={320}
                densities={[1, 2]}
                format="webp"
                quality={75}
                loading="lazy"
                decoding="async"
                data-shot={name}
              />
            ))
          }
        </span>
        <span class="site-preview-host"></span>
      </div>

      <footer>
        {
          copy.footer.map((f) => (
            <>
              {f.label}{" "}
              <a href={f.link.href} target="_blank" rel="noopener">
                {f.link.label}
              </a>
            </>
          ))
        }
        .
      </footer>
    </div>
  </div>
</Layout>

<script>
  import { previewHost } from "../lib/preview";

  const card = document.querySelector<HTMLElement>("[data-preview-card]");
  const host = card?.querySelector<HTMLElement>(".site-preview-host");
  if (card && host && matchMedia("(hover: hover)").matches) {
    const GAP = 12;
    const EDGE = 8;
    /* Every screenshot is a lazy <img> kept out of layout, so only the ones shown get fetched. */
    const shots = new Map(
      [...card.querySelectorAll<HTMLImageElement>("img[data-shot]")].map((img) => [img.dataset.shot, img]),
    );
    const hide = () => card.removeAttribute("data-show");
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-preview]")) {
      link.addEventListener("pointerenter", () => {
        const shot = shots.get(link.dataset.preview);
        if (!shot) return;
        for (const img of shots.values()) img.toggleAttribute("data-active", img === shot);
        const loaded = shot.complete && shot.naturalWidth > 0;
        card.toggleAttribute("data-loaded", loaded);
        card.removeAttribute("data-failed");
        if (!loaded) {
          shot.addEventListener("load", () => card.toggleAttribute("data-loaded", shot.hasAttribute("data-active")), { once: true });
          shot.addEventListener("error", () => card.toggleAttribute("data-failed", shot.hasAttribute("data-active")), { once: true });
        }
        host.textContent = previewHost(link.href);
        const box = link.getBoundingClientRect();
        const { width, height } = card.getBoundingClientRect();
        const left = Math.min(
          Math.max(EDGE, box.left + box.width / 2 - width / 2),
          innerWidth - width - EDGE,
        );
        const above = box.top - height - GAP >= EDGE;
        card.style.left = `${left}px`;
        card.style.top = `${above ? box.top - height - GAP : box.bottom + GAP}px`;
        card.dataset.side = above ? "above" : "below";
        card.toggleAttribute("data-show", true);
      });
      link.addEventListener("pointerleave", hide);
    }
    addEventListener("scroll", hide, { passive: true });
  }

  if (!matchMedia("(hover: hover)").matches) {
    const lanes = [...document.querySelectorAll<HTMLElement>(".lane")];
    addEventListener("click", (event) => {
      const hit = (event.target as Element).closest<HTMLElement>(".lane");
      for (const lane of lanes) lane.toggleAttribute("data-open", lane === hit && !lane.hasAttribute("data-open"));
    });
  }

  const pack = document.querySelector<HTMLDialogElement>("[data-pack]");
  const track = pack?.querySelector<HTMLElement>("[data-pack-track]");
  const stories = [...(pack?.querySelectorAll<HTMLElement>("[data-pack-story]") ?? [])];
  const prev = pack?.querySelector<HTMLButtonElement>("[data-pack-prev]");
  const next = pack?.querySelector<HTMLButtonElement>("[data-pack-next]");
  const WEEK = [1, 2, 3, 4, 5, 6, 0];
  const PER_DAY = stories.length / WEEK.length;
  const COUNT = stories.length;
  const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  const position = () => (track ? Math.round(track.scrollLeft / track.clientWidth) : 0);
  const current = () => position() % COUNT;
  const scrollTo = (slot: number, smooth: boolean) =>
    track?.scrollTo({ left: slot * track.clientWidth, behavior: smooth && !still() ? "smooth" : "instant" });
  /*
   * A copy of the first GIF sits after the last, so the loop keeps sliding right: past the end
   * it lands on the copy, then quietly jumps back to the real first one.
   */
  let rewinding = false;
  const show = (index: number, smooth = true) => {
    if (!track) return;
    const from = current();
    if (index >= COUNT && from === COUNT - 1) return scrollTo(COUNT, smooth);
    if (index < 0 && from === 0) {
      rewinding = true;
      scrollTo(COUNT, false);
      return requestAnimationFrame(() => scrollTo(COUNT - 1, smooth));
    }
    scrollTo((index + COUNT) % COUNT, smooth);
  };
  const caption = pack?.querySelector<HTMLElement>("[data-pack-caption]");
  let captionTimer = 0;
  const setCaption = (text: string) => {
    if (!caption || caption.textContent === text) return;
    if (!caption.textContent || still()) {
      caption.textContent = text;
      return;
    }
    caption.toggleAttribute("data-fading", true);
    clearTimeout(captionTimer);
    captionTimer = window.setTimeout(() => {
      caption.textContent = text;
      caption.removeAttribute("data-fading");
    }, 150);
  };
  /* Stories-style progress: earlier GIFs are full, the current one fills, later ones wait. */
  let shown = -1;
  const sync = () => {
    if (rewinding && position() !== COUNT) rewinding = false;
    const atCopy = !!track && Math.abs(track.scrollLeft - COUNT * track.clientWidth) < 1;
    if (atCopy && !rewinding) scrollTo(0, false);
    const i = current();
    if (i === shown) return;
    if (shown !== -1 && track?.querySelector("[data-candidate]")) resetSuggestion();
    shown = i;
    setCaption(track?.children[i]?.getAttribute("data-key") ?? "");
    stories.forEach((story, s) => {
      story.toggleAttribute("data-done", s < i);
      story.toggleAttribute("aria-current", s === i);
    });
  };
  track?.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
  prev?.addEventListener("click", () => show(current() - 1));
  next?.addEventListener("click", () => show(current() + 1));
  stories.forEach((story, s) => story.addEventListener("click", () => show(s)));
  /* When the current GIF's bar fills up, move on to the next one. */
  pack?.addEventListener("animationend", (event) => {
    if ((event.target as Element).hasAttribute("aria-current") && event.animationName.includes("story")) {
      show(current() + 1);
    }
  });
  pack?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") show(current() - 1);
    if (event.key === "ArrowRight") show(current() + 1);
  });
  /* Hovering, focusing or reviewing a GIF holds its bar, so there's time to look or copy. */
  const holders = [track, pack?.querySelector<HTMLElement>(".pack-actions")];
  const hold = () =>
    pack?.toggleAttribute(
      "data-paused",
      holders.some((el) => el?.matches(":hover, :focus-within")) ||
        !!track?.querySelector("[data-candidate]"),
    );
  for (const el of holders) {
    for (const type of ["pointerenter", "pointerleave", "focusin", "focusout"]) {
      el?.addEventListener(type, () => requestAnimationFrame(hold));
    }
  }
  const openPack = (index: number) => {
    const items = pack?.querySelector<HTMLTemplateElement>("[data-pack-items]");
    if (track && items && !track.childElementCount) {
      track.append(items.content.cloneNode(true));
      const loop = track.firstElementChild!.cloneNode(true) as HTMLElement;
      loop.inert = true;
      loop.setAttribute("aria-hidden", "true");
      track.append(loop);
    }
    pack?.showModal();
    shown = -1;
    show(index, false);
    sync();
  };
  document.querySelector("[data-pack-open]")?.addEventListener("click", () => {
    openPack(WEEK.indexOf(Number(document.documentElement.dataset.day ?? 1)) * PER_DAY);
  });
  /* #family-12 opens the gallery on that GIF, which is how a review picks up after a reload. */
  const deepLink = /^#family-(\d+)$/.exec(location.hash);
  if (deepLink) openPack(Number(deepLink[1]));
  pack?.addEventListener("close", () => {
    if (location.hash.startsWith("#family-")) history.replaceState(null, "", location.pathname);
  });
  pack?.addEventListener("click", (event) => {
    if (event.target === pack) pack.close();
  });

  const copied = pack?.querySelector<HTMLElement>("[data-pack-copied]");
  let copiedTimer = 0;
  const flash = (text: string) => {
    if (!copied) return;
    copied.textContent = text;
    copied.toggleAttribute("data-show", true);
    clearTimeout(copiedTimer);
    copiedTimer = window.setTimeout(() => {
      copied.removeAttribute("data-show");
      copied.textContent = "";
    }, 1600);
  };
  /* The GIF on screen; during a dev review, the suggestion being previewed. */
  const onScreen = () => {
    const slide = track?.children[current()] as HTMLElement | undefined;
    const gif = slide?.querySelector<HTMLElement>("[data-gif]");
    if (!slide || !gif) return null;
    return { id: slide.dataset.candidate ?? gif.dataset.gif!, alt: gif.querySelector("img")?.alt ?? "" };
  };
  const copyLink = pack?.querySelector<HTMLButtonElement>("[data-copy-link]");
  copyLink?.addEventListener("click", async () => {
    const gif = onScreen();
    if (!gif) return;
    try {
      await navigator.clipboard.writeText(`https://giphy.com/gifs/${gif.id}`);
    } catch {
      return;
    }
    flash(copyLink.dataset.done!);
  });
  const copyGif = pack?.querySelector<HTMLButtonElement>("[data-copy-gif]");
  copyGif?.addEventListener("click", async () => {
    const gif = onScreen();
    if (!gif) return;
    const base = `https://media.giphy.com/media/${gif.id}`;
    /*
     * Browsers only put still images on the clipboard, so the GIF goes on as HTML (rich editors
     * paste it animated) plus a PNG of its first frame for apps that only take pictures.
     */
    const frame = (async () => {
      const still = new Image();
      still.crossOrigin = "anonymous";
      still.src = `${base}/giphy_s.gif`;
      await still.decode();
      const canvas = document.createElement("canvas");
      canvas.width = still.naturalWidth;
      canvas.height = still.naturalHeight;
      canvas.getContext("2d")!.drawImage(still, 0, 0);
      return new Promise<Blob>((resolve, reject) =>
        canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error("No frame"))), "image/png"),
      );
    })();
    const html = new Blob([`<img src="${base}/giphy.gif" alt="${gif.alt}">`], { type: "text/html" });
    try {
      await navigator.clipboard.write([new ClipboardItem({ "image/png": frame, "text/html": html })]);
    } catch {
      return;
    }
    flash(copyGif.dataset.done!);
  });

  /*
   * Dev only: ask the dev server for another GIF that fits the current slot, preview it in
   * place, and write the chosen one into the site's source. Nothing is kept in the browser.
   */
  const tools = pack?.querySelector<HTMLElement>("[data-suggest]");
  const [suggest, use, cancel] = [
    tools?.querySelector<HTMLButtonElement>("[data-suggest-next]"),
    tools?.querySelector<HTMLButtonElement>("[data-suggest-use]"),
    tools?.querySelector<HTMLButtonElement>("[data-suggest-cancel]"),
  ];
  const showGif = (slide: HTMLElement, id: string) => {
    const base = `https://media.giphy.com/media/${id}`;
    slide.querySelector("img")!.src = `${base}/200w_s.gif`;
    slide.querySelector("source")!.srcset = `${base}/200w.webp`;
  };
  const resetSuggestion = () => {
    for (const slide of track?.querySelectorAll<HTMLElement>("[data-candidate]") ?? []) {
      showGif(slide, slide.querySelector<HTMLElement>("[data-gif]")!.dataset.gif!);
      delete slide.dataset.candidate;
      delete slide.dataset.skip;
    }
    if (suggest && use && cancel) {
      suggest.textContent = suggest.dataset.label ?? suggest.textContent;
      use.hidden = cancel.hidden = true;
    }
    hold();
  };
  if (tools && suggest && use && cancel) {
    suggest.dataset.label = suggest.textContent!;
    cancel.addEventListener("click", resetSuggestion);
    suggest.addEventListener("click", async () => {
      const slide = track?.children[current()] as HTMLElement | undefined;
      if (!slide) return;
      suggest.disabled = true;
      const kind = slide.dataset.theme === "light" ? "dog" : "cat";
      const skip = [slide.dataset.skip, slide.dataset.candidate].filter(Boolean).join(",");
      const res = await fetch(`/__gifs/suggest?kind=${kind}&tag=${slide.dataset.tag}&skip=${skip}`);
      suggest.disabled = false;
      if (!res.ok) {
        suggest.textContent = tools.dataset.none!;
        return;
      }
      const gif: { id: string; width: number; height: number } = await res.json();
      slide.dataset.skip = skip;
      slide.dataset.candidate = gif.id;
      slide.dataset.size = `${gif.width}x${gif.height}`;
      showGif(slide, gif.id);
      suggest.textContent = suggest.dataset.again!;
      use.hidden = cancel.hidden = false;
      hold();
    });
    use.addEventListener("click", async () => {
      const slide = track?.querySelector<HTMLElement>("[data-candidate]");
      if (!slide) return;
      const [width, height] = slide.dataset.size!.split("x").map(Number);
      use.disabled = true;
      const res = await fetch("/__gifs/use", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          tag: slide.dataset.tag,
          day: Number(slide.dataset.day),
          theme: slide.dataset.theme,
          id: slide.dataset.candidate,
          width,
          height,
        }),
      });
      if (!res.ok) {
        use.disabled = false;
        return;
      }
      location.hash = `family-${current()}`;
      location.reload();
    });
  }

  const portrait = document.querySelector<HTMLDialogElement>("[data-avatar-dialog]");
  document.querySelector("[data-avatar-open]")?.addEventListener("click", () => portrait?.showModal());
  portrait?.addEventListener("click", () => portrait.close());

  const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
  const sky = toggle?.querySelector<HTMLElement>(".sky");
  if (
    toggle &&
    sky &&
    matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches
  ) {
    toggle.addEventListener("pointermove", (event) => {
      const box = sky.getBoundingClientRect();
      const tx = ((event.clientX - box.left) / box.width - 0.5) * 2;
      const ty = ((event.clientY - box.top) / box.height - 0.5) * 2;
      sky.style.setProperty("--tx", String(Math.max(-1, Math.min(1, tx))));
      sky.style.setProperty("--ty", String(Math.max(-1, Math.min(1, ty))));
    });
    toggle.addEventListener("pointerleave", () => {
      sky.style.removeProperty("--tx");
      sky.style.removeProperty("--ty");
    });
  }
</script>


