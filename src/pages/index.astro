---
import { Image } from "astro:assets";
import type { SvgComponent } from "astro/types";
import Moon from "../assets/icons/moon.svg";
import Sun from "../assets/icons/sun.svg";
import Layout from "@layouts/layout.astro";
import avatar from "../assets/avatar.jpg";
import { site, type DayGif } from "../content/site";
import { formatPeriodMonths, toYearMonth, yearsSince } from "../lib/dates";
import { gifAnimated, gifStill } from "../lib/gif";
import { axisYears, barPosition, trackPath } from "../lib/timeline";

const now = toYearMonth(new Date());
const copy = site.copy;
const years = yearsSince(site.firstJobStart, now);
const axis = axisYears(site.firstJobStart.year, now);
const logos = import.meta.glob<SvgComponent>("../assets/logos/*.svg", {
  eager: true,
  import: "default",
});
const logo = (file: string) => logos[`../assets/logos/${file}`];
/* Career line geometry, in viewBox units: x is percent of the axis, y is pixels of a lane. */
const LANE = 36;
const CURVE = 2.5;
/*
 * Memes are CSS backgrounds, not <img>s: browsers never fetch a background for an element
 * that isn't rendered, so only today's meme in the current theme is downloaded.
 */
const themes = ["light", "dark"] as const;
const gifVars = (day: DayGif) =>
  [
    `--still-light:url(${gifStill(day.light)})`,
    `--still-dark:url(${gifStill(day.dark)})`,
    `--play-light:url(${gifAnimated(day.light)})`,
    `--play-dark:url(${gifAnimated(day.dark)})`,
  ].join(";");
/* The line draws itself at a steady pace through time, from the first job to today. */
const first = site.experience.at(-1)!;
const origin = barPosition(first.start, first.end, site.firstJobStart.year, now).left - CURVE * 2;
const span = 100 - origin;
const GLINT_W = 8;
const GLINT_H = 3;
const at = (x: number) => Math.max(0, (x - origin) / span).toFixed(4);
/* One gradient for the whole line: each company's colour sits where its job starts. */
const careerStops = site.experience
  .map((e) => ({
    offset: (barPosition(e.start, e.end, site.firstJobStart.year, now).left / 100).toFixed(4),
    style: `--brand:${e.color};--brand-dark:${e.colorDark ?? e.color}`,
  }))
  .reverse();
---

<Layout
  title={site.name}
  description="Frontend-focused product engineer. I make screens you can leave: the best interfaces get you what you need, then let you go."
>
  <div class="page">
    <div class="wrap">
      <header class="head">
        <button type="button" class="avatar-open" aria-label={copy.avatar.open} data-avatar-open>
          <Image
            class="avatar"
            src={avatar}
            alt=""
            width={56}
            height={56}
            densities={[1, 2]}
            loading="eager"
          />
        </button>
        <dialog class="portrait" aria-label={site.name} closedby="any" data-avatar-dialog>
          <Image class="portrait-img" src={avatar} alt={site.name} width={256} height={256} />
          <form method="dialog">
            <button type="submit" class="portrait-close" aria-label={copy.avatar.close}>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </button>
          </form>
        </dialog>
        <span class="scheme">
          <button type="button" aria-label={copy.theme.label} aria-pressed="false" data-theme-toggle>
            <span class="sky">
            <span class="body sun">
              <Sun aria-hidden="true" />
            </span>
            <span class="body moon">
              <Moon aria-hidden="true" />
            </span>
            </span>
          </button>
          <span class="tip" aria-hidden="true">
            <span class="light-only">{copy.theme.toDark}</span>
            <span class="dark-only">{copy.theme.toLight}</span>
          </span>
        </span>
      </header>

      <main>
        <p class="byline">{site.name}</p>
        <h1>{copy.headline.text} <em>{copy.headline.emphasis}</em>.</h1>
        {copy.intro.map((p) => <p>{p}</p>)}
        <p>{copy.facts(years)}</p>

        <section>
          <h2>{copy.sections.experience}</h2>
          <ul>
            {
              site.experience.map((e) => (
                <li class="row">
                  <span class="title">
                    {e.role} at{" "}
                    <a href={e.url} target="_blank" rel="noopener" data-preview>
                      {e.company}
                    </a>
                    {e.client && (
                      <>
                        {" "}
                        for{" "}
                        <a href={e.client.url} target="_blank" rel="noopener" data-preview>
                          {e.client.name}
                        </a>
                      </>
                    )}
                  </span>
                  <span class="meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                </li>
              ))
            }
          </ul>
          <div
            class="chart"
            style={`--years:${axis.length};--lane:${LANE}px;--origin:${origin.toFixed(3)}%`}
            data-chart
          >
            <div class="chart-tools">
              <span class="chart-tool">
                <button
                  type="button"
                  aria-label={copy.chart.speed("1×")}
                  data-chart-speed
                  data-label={copy.chart.speed("{rate}")}
                  data-tip={copy.chart.speedTip("{rate}")}
                >
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M2.5 11.5a5.5 5.5 0 1 1 11 0" />
                    <path class="needle" d="M8 11.5V7" />
                  </svg>
                </button>
                <span class="tool-tip" aria-hidden="true">{copy.chart.speedTip("1×")}</span>
              </span>
              <span class="chart-tool replay">
                <button type="button" aria-label={copy.chart.replay} data-chart-replay>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M3.5 8a4.5 4.5 0 1 0 1.32-3.18M4.5 2.5v2.5H7" />
                  </svg>
                </button>
                <span class="tool-tip" aria-hidden="true">{copy.chart.replayTip}</span>
              </span>
            </div>
            <div class="grid" aria-hidden="true">
              {axis.map(() => (
                <span />
              ))}
            </div>
            <ul class="lanes" aria-hidden="true">
              {
                site.experience.map((e, i) => {
                  const later = site.experience[i - 1];
                  const earlier = site.experience[i + 1];
                  const { left, width } = barPosition(
                    e.start,
                    e.end,
                    site.firstJobStart.year,
                    now,
                    later?.start,
                  );
                  const d = trackPath(left, width, {
                    mid: LANE / 2,
                    rise: earlier ? LANE : undefined,
                    curve: CURVE,
                    continues: Boolean(later),
                  });
                  const Logo = logo(e.logo);
                  return (
                    <li
                      class="lane"
                      style={`--left:${left}%;--width:${width}%;--brand:${e.color};--brand-dark:${e.colorDark ?? e.color};--stop-at:${at(left)}`}
                    >
                      <svg class="track" viewBox={`0 0 100 ${LANE}`} preserveAspectRatio="none">
                        <defs>
                          <linearGradient
                            id={`career-${i}`}
                            gradientUnits="userSpaceOnUse"
                            x1="0"
                            y1="0"
                            x2="100"
                            y2="0"
                          >
                            {careerStops.map((stop) => (
                              <stop offset={stop.offset} style={stop.style} />
                            ))}
                          </linearGradient>
                        </defs>
                        <path d={d} style={`stroke:url(#career-${i})`} />
                        {!e.end && (
                          <>
                            <defs>
                              <linearGradient id="glint">
                                <stop offset="0" stop-color="#fff" stop-opacity="0" />
                                <stop offset="0.5" stop-color="#fff" stop-opacity="0.85" />
                                <stop offset="1" stop-color="#fff" stop-opacity="0" />
                              </linearGradient>
                            </defs>
                            <rect
                              class="glint"
                              x={left}
                              y={LANE / 2 - GLINT_H / 2}
                              width={GLINT_W}
                              height={GLINT_H}
                              fill="url(#glint)"
                              style={`--run:${(width - GLINT_W).toFixed(3)}`}
                            />
                          </>
                        )}
                      </svg>
                      <span class="stop">
                        <span class="stop-logo">
                          <Logo width={18} height={18} aria-hidden="true" />
                        </span>
                      </span>
                      {
                        !e.end && (
                          <span class="now">
                            <span class="light-only">
                              <Sun aria-hidden="true" />
                            </span>
                            <span class="dark-only">
                              <Moon aria-hidden="true" />
                            </span>
                          </span>
                        )
                      }
                      <span class="card">
                        <span class="card-logo">
                          <Logo width={20} height={20} aria-hidden="true" />
                        </span>
                        <span class="card-text">
                          <span class="card-title">
                            {e.role} at {e.company}
                            {e.client && ` for ${e.client.name}`}
                          </span>
                          <span class="card-meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                        </span>
                      </span>
                    </li>
                  );
                })
              }
            </ul>
            <div class="axis" aria-hidden="true">
              {axis.map((y) => (
                <span>{y}</span>
              ))}
            </div>
          </div>
        </section>

        <section>
          <h2>{copy.sections.projects}</h2>
          <ul>
            {
              site.projects.map((p) => (
                <li>
                  <a class="row" href={p.repo} target="_blank" rel="noopener">
                    <span class="title">{p.title}</span>
                    <span class="meta">{p.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{copy.sections.links}</h2>
          <p class="links">
            {
              site.links.map((l) => (
                <a class="cta" href={l.href} target="_blank" rel="noopener">
                  <span class="cta-gif" aria-hidden="true">
                    {l.gifs.map((day, d) => (
                      <span class={`shot day day-${d}`} style={gifVars(day)} />
                    ))}
                  </span>
                  <span class="cta-card" aria-hidden="true">
                    {l.gifs.map((day, d) => (
                      <span class={`shot day day-${d}`} style={gifVars(day)} />
                    ))}
                  </span>
                  {l.label}
                </a>
              ))
            }
          </p>
          <p class="pack-open-row">
            <button type="button" class="pack-open" data-pack-open>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <ellipse cx="8" cy="10.5" rx="3" ry="2.5" />
                <circle cx="3.5" cy="7" r="1.25" />
                <circle cx="6" cy="4.25" r="1.25" />
                <circle cx="10" cy="4.25" r="1.25" />
                <circle cx="12.5" cy="7" r="1.25" />
              </svg>
              {copy.pack.open}
            </button>
          </p>
          <dialog class="pack" aria-labelledby="pack-title" data-pack>
            <header class="pack-head">
              <div>
                <h2 id="pack-title" class="pack-title">{copy.pack.title}</h2>
                <p class="pack-lede">{copy.pack.lede}</p>
              </div>
              <form method="dialog">
                <button type="submit" class="dialog-close" aria-label={copy.pack.close}>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path
                      d="M4 4l8 8M12 4l-8 8"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
              </form>
            </header>
            <div class="pack-grid" data-pack-grid></div>
            <template data-pack-items>
              {[1, 2, 3, 4, 5, 6, 0].flatMap((d) =>
                site.links.flatMap((l) =>
                  themes.map((theme) => (
                    <figure class={`pack-item pack-day-${d}`}>
                      <picture>
                        <source
                          media="(prefers-reduced-motion: no-preference)"
                          srcset={gifAnimated(l.gifs[d][theme])}
                          type="image/webp"
                        />
                        <img
                          src={gifStill(l.gifs[d][theme])}
                          alt={`A ${theme === "light" ? "dog" : "cat"} ${l.meme}`}
                          loading="lazy"
                        />
                      </picture>
                      <figcaption>
                        {copy.pack.days[d]} · {l.label}
                        <span class="pack-today">{copy.pack.today}</span>
                      </figcaption>
                    </figure>
                  )),
                ),
              )}
            </template>
          </dialog>
        </section>
      </main>

      <div class="site-preview" aria-hidden="true" data-preview-card>
        <span class="site-preview-shot"></span>
        <span class="site-preview-host"></span>
      </div>

      <footer>
        {
          copy.footer.map((f) => (
            <>
              {f.label}{" "}
              <a href={f.link.href} target="_blank" rel="noopener">
                {f.link.label}
              </a>
            </>
          ))
        }
        .
      </footer>
    </div>
  </div>
</Layout>

<script>
  import { previewHost, previewImage } from "../lib/preview";


  /*
   * Hovering a company shows a fresh screenshot of its website above the link. Touch screens
   * skip it: a tap should just follow the link. Nothing is requested until the first hover.
   */
  const card = document.querySelector<HTMLElement>("[data-preview-card]");
  /* The image is made here, not in the markup, so the page never ships an <img> without a src. */
  const shot = new Image();
  shot.alt = "";
  shot.decoding = "async";
  card?.querySelector(".site-preview-shot")?.append(shot);
  const host = card?.querySelector<HTMLElement>(".site-preview-host");
  if (card && shot && host && matchMedia("(hover: hover)").matches) {
    const GAP = 12;
    const EDGE = 8;
    shot.addEventListener("load", () => card.toggleAttribute("data-loaded", true));
    /* If the screenshot can't be made (rate limit, site down), quietly drop the card. */
    shot.addEventListener("error", () => card.toggleAttribute("data-failed", true));
    const hide = () => card.removeAttribute("data-show");
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-preview]")) {
      link.addEventListener("pointerenter", () => {
        const src = previewImage(link.href);
        if (shot.getAttribute("src") !== src) {
          card.removeAttribute("data-loaded");
          card.removeAttribute("data-failed");
          shot.src = src;
        }
        host.textContent = previewHost(link.href);
        const box = link.getBoundingClientRect();
        const { width, height } = card.getBoundingClientRect();
        const left = Math.min(
          Math.max(EDGE, box.left + box.width / 2 - width / 2),
          innerWidth - width - EDGE,
        );
        const above = box.top - height - GAP >= EDGE;
        card.style.left = `${left}px`;
        card.style.top = `${above ? box.top - height - GAP : box.bottom + GAP}px`;
        card.dataset.side = above ? "above" : "below";
        card.toggleAttribute("data-show", true);
      });
      link.addEventListener("pointerleave", hide);
    }
    addEventListener("scroll", hide, { passive: true });
  }

  /* The line draws itself once the chart is on screen; once it's done, it can be replayed. */
  const chart = document.querySelector<HTMLElement>("[data-chart]");
  if (chart) {
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        chart.toggleAttribute("data-seen", true);
        observer.disconnect();
      },
      { threshold: 0.4 },
    ).observe(chart);
  }
  /* Today's marker pops in last, so its pop ending means the drawing is done. */
  chart?.addEventListener("animationend", (event) => {
    const target = event.target as Element;
    if (event.animationName === "pop" && target.classList.contains("now")) {
      chart.toggleAttribute("data-done", true);
    }
  });
  /* Replay drops every animation for one frame of style, then lets them all start over. */
  const RATES = [1, 2, 0.5];
  let rate = 1;
  const applyRate = () => {
    for (const animation of chart?.getAnimations({ subtree: true }) ?? []) {
      animation.updatePlaybackRate(rate);
    }
  };
  chart?.querySelector("[data-chart-replay]")?.addEventListener("click", () => {
    chart.removeAttribute("data-done");
    chart.toggleAttribute("data-replay", true);
    chart.getBoundingClientRect();
    chart.removeAttribute("data-replay");
    chart.getBoundingClientRect();
    applyRate();
  });
  const speed = chart?.querySelector<HTMLButtonElement>("[data-chart-speed]");
  speed?.addEventListener("click", () => {
    rate = RATES[(RATES.indexOf(rate) + 1) % RATES.length];
    const label = `${rate}×`;
    speed.setAttribute("aria-label", speed.dataset.label!.replace("{rate}", label));
    speed.nextElementSibling!.textContent = speed.dataset.tip!.replace("{rate}", label);
    speed.style.setProperty("--needle", `${Math.log2(rate) * 50}deg`);
    applyRate();
  });

  /* On touch screens a tap opens a lane's card; tapping it again or anywhere else closes it. */
  if (!matchMedia("(hover: hover)").matches) {
    const lanes = [...document.querySelectorAll<HTMLElement>(".lane")];
    addEventListener("click", (event) => {
      const hit = (event.target as Element).closest<HTMLElement>(".lane");
      for (const lane of lanes) lane.toggleAttribute("data-open", lane === hit && !lane.hasAttribute("data-open"));
    });
  }

  const pack = document.querySelector<HTMLDialogElement>("[data-pack]");
  document.querySelector("[data-pack-open]")?.addEventListener("click", () => {
    const grid = pack?.querySelector("[data-pack-grid]");
    const items = pack?.querySelector<HTMLTemplateElement>("[data-pack-items]");
    if (grid && items && !grid.childElementCount) grid.append(items.content.cloneNode(true));
    pack?.showModal();
  });
  pack?.addEventListener("click", (event) => {
    if (event.target === pack) pack.close();
  });

  const portrait = document.querySelector<HTMLDialogElement>("[data-avatar-dialog]");
  document.querySelector("[data-avatar-open]")?.addEventListener("click", () => portrait?.showModal());
  /* Clicking the photo or the backdrop zooms back out, like the close button. */
  portrait?.addEventListener("click", () => portrait.close());

  const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
  const sky = toggle?.querySelector<HTMLElement>(".sky");
  if (
    toggle &&
    sky &&
    matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches
  ) {
    toggle.addEventListener("pointermove", (event) => {
      const box = sky.getBoundingClientRect();
      const tx = ((event.clientX - box.left) / box.width - 0.5) * 2;
      const ty = ((event.clientY - box.top) / box.height - 0.5) * 2;
      sky.style.setProperty("--tx", String(Math.max(-1, Math.min(1, tx))));
      sky.style.setProperty("--ty", String(Math.max(-1, Math.min(1, ty))));
    });
    toggle.addEventListener("pointerleave", () => {
      sky.style.removeProperty("--tx");
      sky.style.removeProperty("--ty");
    });
  }
</script>


<style>
  .page {
    /* Color */
    --bg: light-dark(#faf7f0, #0e131b); /* Background */
    --fg: light-dark(#231f17, #dfe6f1); /* Foreground */
    --muted: light-dark(#756b57, #909fb6);
    --rule: light-dark(#e7e1d5, #252d39);
    --logo-bg: light-dark(#fff, #dfe6f1);

    /* Font face */
    --font: "Inter Variable", system-ui, sans-serif;
    --font-heading: "Averia Serif Libre", Georgia, serif;

    /* Font size scale: Minor Third (factor of 1.2) - typescale.com */
    --text-display: 2.986rem; /* h1 */
    --text-body: 1rem; /* p */
    --text-caption: 0.833rem; /* small */
    --text-micro: 0.694rem;

    /* Vertical rhythm: open leading for text, tight for headings */
    --leading-text: 1.6;
    --leading-heading: 1.2;
    --weight-regular: 400;
    --weight-medium: 500;
    --weight-bold: 700;
    --opsz-regular: 14;
    --opsz-bold: 25;

    /* Spacing on a 4px grid */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;
    --space-12: 48px;
    --space-14: 56px;
    --space-16: 64px;
    /* Space between blocks: body line height / 1.5, on the 4px grid */
    --flow: var(--space-4);
    /* Space before a section heading: twice the flow, three times on wider screens */
    --section-gap: calc(var(--flow) * 2);

    /* Lines */
    --hairline: 1px solid var(--rule);
    --focus-ring: 1px solid var(--fg);
    --focus-offset: 2px;
    --underline: 1px;
    --underline-hover: 2px;
    --underline-offset: 3px;

    /* Shape */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 16px;
    --radius-pill: 999px;

    /* Sizes */
    --measure: 640px;
    --avatar: 56px;
    --portrait: 256px;
    --tap: 64px;
    --icon: 56px;
    --popover: 240px;
    --preview: 320px;
    --gif: 200px;

    /* Motion */
    --duration: 150ms;
    --ease: ease-out;

    position: relative;
    isolation: isolate;
    overflow-x: clip;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    font-variation-settings: "opsz" var(--opsz-regular);
    font-weight: var(--weight-regular);
    font-synthesis: none;
    font-size: var(--text-body);
    line-height: var(--leading-text);
  }
  .page ::selection {
    background: var(--fg);
    color: var(--bg);
  }
  .page a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-10) var(--space-5) var(--space-12);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 30%;
    corner-shape: squircle;
  }
  .avatar-open {
    border-radius: 30%;
    corner-shape: squircle;
    cursor: zoom-in;
  }
  .avatar-open:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* The dialog sits in the top layer, so it carries its own colours from the page tokens. */
  .portrait {
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: var(--fg);
  }
  .portrait::backdrop,
  .pack::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(4px);
  }
  .portrait-img {
    width: min(var(--portrait), calc(100vw - var(--space-10)));
    height: auto;
    border-radius: 30%;
    corner-shape: squircle;
    cursor: zoom-out;
  }
  .portrait-close {
    position: absolute;
    top: calc(var(--space-2) * -1);
    right: calc(var(--space-2) * -1);
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    border: var(--hairline);
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }
  .portrait-close:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
