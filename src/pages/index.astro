---
import { Image } from "astro:assets";
import type { SvgComponent } from "astro/types";
import Moon from "../assets/icons/moon.svg";
import Sun from "../assets/icons/sun.svg";
import Layout from "@layouts/layout.astro";
import avatar from "../assets/avatar.jpg";
import { site } from "../content/site";
import { formatPeriodMonths, toYearMonth, yearsSince } from "../lib/dates";
import { axisYears, barPosition } from "../lib/timeline";

const now = toYearMonth(new Date());
const copy = site.copy;
const years = yearsSince(site.firstJobStart, now);
const axis = axisYears(site.firstJobStart.year, now);
const logos = import.meta.glob<SvgComponent>("../assets/logos/*.svg", {
  eager: true,
  import: "default",
});
const logo = (file: string) => logos[`../assets/logos/${file}`];
---

<Layout
  title={site.name}
  description="Frontend-focused product engineer. I make screens you can leave: the best interfaces get you what you need, then let you go."
>
  <div class="page">
    <div class="wrap">
      <header class="head">
        <Image
          class="avatar"
          src={avatar}
          alt=""
          width={56}
          height={56}
          densities={[1, 2]}
          loading="eager"
        />
        <span class="scheme">
          <button type="button" aria-label={copy.theme.label} aria-pressed="false" data-theme-toggle>
            <span class="sky">
            <span class="body sun">
              <Sun aria-hidden="true" />
            </span>
            <span class="body moon">
              <Moon aria-hidden="true" />
            </span>
            </span>
          </button>
          <span class="tip" aria-hidden="true">
            <span class="light-only">{copy.theme.toDark}</span>
            <span class="dark-only">{copy.theme.toLight}</span>
          </span>
        </span>
      </header>

      <main>
        <p class="byline">{site.name}</p>
        <h1>{copy.headline}</h1>
        {copy.intro.map((p) => <p>{p}</p>)}
        <p>{copy.facts(years)}</p>

        <section>
          <h2>{copy.sections.experience}</h2>
          <ul>
            {
              site.experience.map((e) => (
                <li class="row">
                  <span class="title">
                    {e.role} at{" "}
                    <a href={e.url} target="_blank" rel="noopener">
                      {e.company}
                    </a>
                    {e.client && (
                      <>
                        {" "}
                        for{" "}
                        <a href={e.client.url} target="_blank" rel="noopener">
                          {e.client.name}
                        </a>
                      </>
                    )}
                  </span>
                  <span class="meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                </li>
              ))
            }
          </ul>
          <div class="chart" style={`--years:${axis.length}`} aria-hidden="true">
            <div class="grid">
              {axis.map(() => (
                <span />
              ))}
            </div>
            <ul class="lanes">
              {
                site.experience.map((e, i) => {
                  const next = site.experience[i - 1];
                  const { left, width } = barPosition(
                    e.start,
                    e.end,
                    site.firstJobStart.year,
                    now,
                    next?.start,
                  );
                  const Logo = logo(e.logo);
                  return (
                    <li
                      class="lane"
                      style={`--left:${left}%;--width:${width}%;--brand:${e.color};--brand-dark:${e.colorDark ?? e.color}`}
                    >
                      <span class="logo">
                        <Logo width={26} height={26} aria-hidden="true" />
                      </span>
                      <span class="bar" />
                      <span class="card">
                        <span class="card-title">
                          {e.role} at {e.company}
                          {e.client && ` for ${e.client.name}`}
                        </span>
                        <span class="card-meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                      </span>
                    </li>
                  );
                })
              }
            </ul>
            <div class="axis">
              {axis.map((y) => (
                <span>{y}</span>
              ))}
            </div>
          </div>
        </section>

        <section>
          <h2>{copy.sections.projects}</h2>
          <ul>
            {
              site.projects.map((p) => (
                <li>
                  <a class="row" href={p.repo} target="_blank" rel="noopener">
                    <span class="title">{p.title}</span>
                    <span class="meta">{p.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{copy.sections.links}</h2>
          <p class="links">
            {
              site.links.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">/</span>}
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                </>
              ))
            }
          </p>
        </section>
      </main>

      <footer>
        {
          copy.footer.map((f) => (
            <>
              {f.label}{" "}
              <a href={f.link.href} target="_blank" rel="noopener">
                {f.link.label}
              </a>
            </>
          ))
        }
      </footer>
    </div>
  </div>
</Layout>

<script>
  const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
  const sky = toggle?.querySelector<HTMLElement>(".sky");
  if (
    toggle &&
    sky &&
    matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches
  ) {
    toggle.addEventListener("pointermove", (event) => {
      const box = sky.getBoundingClientRect();
      const tx = ((event.clientX - box.left) / box.width - 0.5) * 2;
      const ty = ((event.clientY - box.top) / box.height - 0.5) * 2;
      sky.style.setProperty("--tx", String(Math.max(-1, Math.min(1, tx))));
      sky.style.setProperty("--ty", String(Math.max(-1, Math.min(1, ty))));
    });
    toggle.addEventListener("pointerleave", () => {
      sky.style.removeProperty("--tx");
      sky.style.removeProperty("--ty");
    });
  }
</script>


<style>
  .page {
    /* Color */
    --bg: light-dark(#faf7f0, #0e131b); /* Background */
    --fg: light-dark(#231f17, #dfe6f1); /* Foreground */
    --muted: light-dark(#756b57, #909fb6);
    --rule: light-dark(#e7e1d5, #252d39);
    --logo-bg: light-dark(#fff, #dfe6f1);

    /* Font face */
    --font: "Inter Variable", system-ui, sans-serif;
    --font-heading: "Averia Serif Libre", Georgia, serif;

    /* Font size scale: Minor Third (factor of 1.2) - typescale.com */
    --text-display: 2.986rem; /* h1 */
    --text-body: 1rem; /* p */
    --text-caption: 0.833rem; /* small */
    --text-micro: 0.694rem;

    /* Vertical rhythm: open leading for text, tight for headings */
    --leading-text: 1.6;
    --leading-heading: 1.2;
    --weight-regular: 400;
    --weight-bold: 700;
    --opsz-regular: 14;
    --opsz-bold: 25;

    /* Spacing on a 4px grid */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;
    --space-12: 48px;
    --space-14: 56px;
    --space-16: 64px;
    /* Space between blocks: body line height / 1.5, on the 4px grid */
    --flow: var(--space-4);
    /* Space before a section heading: twice the flow, three times on wider screens */
    --section-gap: calc(var(--flow) * 2);

    /* Lines */
    --hairline: 1px solid var(--rule);
    --focus-ring: 1px solid var(--fg);
    --focus-offset: 2px;
    --underline: 1px;
    --underline-hover: 2px;
    --underline-offset: 3px;

    /* Shape */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 16px;

    /* Sizes */
    --measure: 640px;
    --avatar: 56px;
    --tap: 64px;
    --icon: 56px;
    --popover: 240px;

    /* Motion */
    --duration: 150ms;
    --ease: ease-out;

    position: relative;
    isolation: isolate;
    overflow-x: clip;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    font-variation-settings: "opsz" var(--opsz-regular);
    font-weight: var(--weight-regular);
    font-synthesis: none;
    font-size: var(--text-body);
    line-height: var(--leading-text);
  }
  .page ::selection {
    background: var(--fg);
    color: var(--bg);
  }
  .page a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-10) var(--space-5) var(--space-12);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 30%;
    corner-shape: squircle;
  }

  .byline {
    margin-top: var(--section-gap);
  }
  /* Quiet labels: the byline and section headings step back so the text leads. */
  .byline,
  h2 {
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
  }
  h1 {
    margin-top: var(--space-1);
    font-family: var(--font-heading);
    font-size: var(--text-display);
    line-height: var(--leading-heading);
    font-weight: var(--weight-bold);
    font-variation-settings: "opsz" var(--opsz-bold);
  }
  p {
    margin-top: var(--flow);
  }
  section,
  footer {
    margin-top: var(--section-gap);
  }
  ul {
    margin-top: var(--flow);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: var(--hairline);
  }
  li.row:last-child,
  li:last-child > a.row {
    border-bottom: 0;
  }
  .title {
    min-width: 0;
  }
  .meta {
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
    white-space: nowrap;
  }

  /* The table above carries the same facts, so the chart is aria-hidden. */
  .chart {
    --lane: 44px;
    --logo: 32px;
    --logo-mark: 26px;
    --logo-gap: var(--space-2);
    --bar: 18px;
    --axis: 32px;
    --dimmed: 0.35;
    --inset-x: var(--space-3);
    --inset-y: 0px;

    position: relative;
    margin-top: var(--flow);
    padding: var(--inset-y) var(--inset-x);
    border: var(--hairline);
    border-radius: var(--radius-xl);
    corner-shape: squircle;
  }
  .grid {
    position: absolute;
    inset: 0 var(--inset-x);
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
  }
  .grid span + span {
    border-left: var(--hairline);
  }
  .lanes {
    position: relative;
    margin-top: 0;
  }
  .lane {
    position: relative;
    height: var(--lane);
  }
  .logo {
    position: absolute;
    top: calc((var(--lane) - var(--logo)) / 2);
    left: max(0px, calc(var(--left) - var(--logo) - var(--logo-gap)));
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--logo);
    height: var(--logo);
    overflow: hidden;
    border-radius: var(--radius-lg);
    corner-shape: squircle;
    background: var(--logo-bg);
    box-shadow: 0 0 0 1px var(--rule);
  }
  .logo svg {
    width: var(--logo-mark);
    height: var(--logo-mark);
  }
  .bar {
    position: absolute;
    top: calc((var(--lane) - var(--bar)) / 2);
    left: var(--left);
    width: var(--width);
    height: var(--bar);
    border-radius: var(--radius-sm);
    background: light-dark(var(--brand), var(--brand-dark));
  }
  .lanes:hover .lane:not(:hover) .bar,
  .lanes:hover .lane:not(:hover) .logo {
    opacity: var(--dimmed);
  }
  .lane:hover {
    z-index: 2;
  }
  .card {
    position: absolute;
    top: calc(var(--lane) - var(--space-1));
    left: clamp(0px, calc(var(--left) - var(--logo) - var(--logo-gap)), calc(100% - var(--popover)));
    z-index: 1;
    display: grid;
    width: max-content;
    max-width: var(--popover);
    padding: var(--space-2) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--bg);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .lane:hover .card {
    visibility: visible;
    opacity: 1;
  }
  .card-meta {
    color: var(--muted);
  }
  .axis {
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
    height: var(--axis);
    align-items: center;
    color: var(--muted);
    font-size: var(--text-micro);
    line-height: var(--leading-text);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bar,
    .logo {
      transition: opacity var(--duration) var(--ease);
    }
    .card {
      transition:
        opacity var(--duration) var(--ease),
        visibility 0s var(--duration);
    }
    .lane:hover .card {
      transition: opacity var(--duration) var(--ease);
    }
  }

  .scheme {
    position: relative;
    margin-left: auto;
  }
  .scheme button {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    position: relative;
    z-index: 2;
    border-radius: 50%;
    color: var(--muted);
    cursor: pointer;
  }
  .scheme button:hover,
  .scheme button:focus-visible {
    color: var(--fg);
  }
  .scheme button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .sky {
    view-transition-name: theme-icon;
    position: relative;
    width: var(--icon);
    height: var(--icon);
    /* The horizon sits a little below the icon, so its glow isn't cut. */
    --horizon: 16px;
    clip-path: inset(-100% -100% calc(var(--horizon) * -1) -100%);
  }
  .body {
    position: absolute;
    inset: 0;
  }
  .scheme svg {
    display: block;
    width: var(--icon);
    height: var(--icon);
    filter: drop-shadow(0 0 6px var(--halo))
      drop-shadow(calc(var(--tx, 0) * 2px) calc(var(--ty, 0) * 2px) 6px var(--aura, transparent));
  }
  .sun {
    --halo: rgb(255 180 60 / 0.55);
  }
  .moon {
    --halo: rgb(255 255 255 / 0.4);
  }
  .scheme button:is(:hover, :focus-visible) .sun {
    --aura: rgb(255 170 50 / 0.6);
  }
  .scheme button:is(:hover, :focus-visible) .moon {
    --aura: rgb(255 255 255 / 0.5);
  }
  .sun {
    translate: 0 0;
    opacity: 1;
  }
  .moon {
    opacity: 0;
  }
  :global([data-theme="dark"]) .sun {
    translate: 0 calc(100% + var(--horizon));
    opacity: 0;
  }
  :global([data-theme="dark"]) .moon {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .scheme svg {
      transition: filter var(--duration) var(--ease);
    }
    .sun {
      transition:
        translate var(--swap) var(--daybreak-ease),
        opacity var(--swap) var(--daybreak-ease);
    }
    .moon {
      transition: opacity var(--swap) var(--daybreak-ease);
    }
  }
  .dark-only,
  :global([data-theme="dark"]) .light-only {
    display: none;
  }
  :global([data-theme="dark"]) .dark-only {
    display: inline;
  }
  :global(:root:not([data-theme])) .scheme {
    display: none;
  }
  .tip {
    position: absolute;
    top: calc(100% + var(--space-4));
    right: 0;
    z-index: 1;
    width: max-content;
    max-width: min(var(--popover), calc(100vw - var(--space-10)));
    padding: var(--space-2) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--fg);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
    visibility: hidden;
    opacity: 0;
  }
  /* Touch screens keep :hover after a tap, so the tip only follows a real pointer. */
  @media (hover: hover) {
    .scheme:hover .tip {
      visibility: visible;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tip {
      transition:
        opacity var(--duration) var(--ease),
        visibility 0s var(--duration);
    }
    .scheme:hover .tip {
      transition: opacity var(--duration) var(--ease);
    }
  }

  footer {
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: var(--leading-text);
  }
  .title a,
  a.row .title,
  .links a,
  footer a {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    text-decoration-thickness: var(--underline);
    text-decoration-color: var(--muted);
  }
  .title a:hover,
  a.row:hover .title,
  .links a:hover,
  footer a:hover {
    text-decoration-color: var(--fg);
    text-decoration-thickness: var(--underline-hover);
  }
  @media (prefers-reduced-motion: no-preference) {
    .title a,
    a.row .title,
    .links a,
    footer a {
      transition:
        text-decoration-thickness var(--duration) var(--ease),
        text-decoration-color var(--duration) var(--ease);
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--fg);
  }
  .links span {
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .row {
      flex-direction: column;
      gap: 0;
    }
    .chart {
      --inset-x: 0px;
      border: 0;
    }
  }
  @media (min-width: 640px) {
    .page {
      --section-gap: calc(var(--flow) * 3);
    }
    .wrap {
      padding: var(--space-16) var(--space-8) var(--space-14);
    }
    .chart {
      --inset-x: var(--space-6);
      --inset-y: var(--space-4);
    }
  }
</style>
