---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@layouts/layout.astro";
import avatar from "../assets/avatar.jpg";
import { site } from "../content/site";
import { formatPeriodMonths, toYearMonth, yearsSince } from "../lib/dates";
import { axisYears, barPosition } from "../lib/timeline";

const now = toYearMonth(new Date());
const copy = site.copy;
const years = yearsSince(site.firstJobStart, now);
const axis = axisYears(site.firstJobStart.year, now);
const logos = import.meta.glob<{ default: ImageMetadata }>("../assets/logos/*", { eager: true });
const logo = (file: string) => logos[`../assets/logos/${file}`].default;
---

<Layout
  title={site.name}
  description="Frontend-focused product engineer. I make screens you can leave: the best interfaces get you what you need, then let you go."
>
  <div class="page">
    <div class="wrap">
      <header class="head">
        <Image
          class="avatar"
          src={avatar}
          alt=""
          width={56}
          height={56}
          densities={[1, 2]}
          loading="eager"
        />
        <span class="scheme">
          <button type="button" aria-label="Light and dark mode" aria-describedby="scheme-tip">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
            </svg>
          </button>
          <span class="tip" role="tooltip" id="scheme-tip">{copy.colorScheme}</span>
        </span>
      </header>

      <main>
        <p class="byline">{site.name}</p>
        <h1>{copy.headline}</h1>
        {copy.intro.map((p) => <p>{p}</p>)}
        <p>{copy.facts(years)}</p>

        <section>
          <h2>{copy.sections.experience}</h2>
          <ul>
            {
              site.experience.map((e) => (
                <li class="row">
                  <span class="title">
                    {e.role} at{" "}
                    <a href={e.url} target="_blank" rel="noopener">
                      {e.company}
                    </a>
                    {e.client && (
                      <>
                        {" "}
                        for{" "}
                        <a href={e.client.url} target="_blank" rel="noopener">
                          {e.client.name}
                        </a>
                      </>
                    )}
                  </span>
                  <span class="meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                </li>
              ))
            }
          </ul>
          <div class="chart" style={`--years:${axis.length}`} aria-hidden="true">
            <div class="grid">
              {axis.map(() => (
                <span />
              ))}
            </div>
            <ul class="lanes">
              {
                site.experience.map((e, i) => {
                  // Experience is newest first, so the job that came next is the previous one.
                  const next = site.experience[i - 1];
                  const { left, width } = barPosition(
                    e.start,
                    e.end,
                    site.firstJobStart.year,
                    now,
                    next?.start,
                  );
                  return (
                    <li
                      class="lane"
                      style={`--left:${left}%;--width:${width}%;--brand:${e.color};--brand-dark:${e.colorDark ?? e.color}`}
                    >
                      <span class="logo">
                        <Image
                          src={logo(e.logo)}
                          alt=""
                          width={26}
                          height={26}
                          densities={[1, 2]}
                          loading="eager"
                        />
                      </span>
                      <span class="bar" />
                      <span class="card">
                        <span class="card-title">
                          {e.role} at {e.company}
                          {e.client && ` for ${e.client.name}`}
                        </span>
                        <span class="card-meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                      </span>
                    </li>
                  );
                })
              }
            </ul>
            <div class="axis">
              {axis.map((y) => (
                <span>{y}</span>
              ))}
            </div>
          </div>
        </section>

        <section>
          <h2>{copy.sections.projects}</h2>
          <ul>
            {
              site.projects.map((p) => (
                <li>
                  <a class="row" href={p.repo} target="_blank" rel="noopener">
                    <span class="title">{p.title}</span>
                    <span class="meta">{p.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{copy.sections.links}</h2>
          <p class="links">
            {
              site.links.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">/</span>}
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                </>
              ))
            }
          </p>
        </section>
      </main>

      <footer>
        {
          copy.footer.map((f) => (
            <>
              {f.label}{" "}
              <a href={f.link.href} target="_blank" rel="noopener">
                {f.link.label}
              </a>
            </>
          ))
        }
      </footer>
    </div>
  </div>
</Layout>

<style>
  .page {
    /* Color */
    --bg: #fdfcfa; /* Background */
    --fg: #1c1917; /* Foreground */
    --muted: #78716c;
    --rule: #e7e5e4;
    --logo-bg: #fff;

    /* Type roles: size, line height, weight and its optical size */
    --font: "Inter Variable", system-ui, sans-serif;
    --text-display: 32px;
    --leading-display: 42px;
    --text-title: 20px;
    --leading-title: 30px;
    --text-body: 16px;
    --leading-body: 26px;
    --text-caption: 14px;
    --leading-caption: 22px;
    --text-micro: 12px;
    --leading-micro: 18px;
    --weight-regular: 400;
    --weight-semibold: 550;
    --weight-bold: 700;
    --opsz-regular: 14;
    --opsz-semibold: 18;
    --opsz-bold: 25;

    /* Spacing on a 4px grid */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;
    --space-12: 48px;
    --space-14: 56px;
    --space-16: 64px;
    --section-gap: var(--space-12);

    /* Lines */
    --hairline: 1px solid var(--rule);
    --focus-ring: 1px solid var(--fg);
    --underline: 1px;
    --underline-hover: 2px;
    --underline-offset: 3px;

    /* Shape */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 16px;

    /* Sizes */
    --measure: 640px;
    --avatar: 56px;
    --tap: 40px;
    --icon: 24px;
    --popover: 240px;

    /* Motion */
    --duration: 150ms;
    --ease: ease-out;

    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    font-variation-settings: "opsz" var(--opsz-regular);
    font-weight: var(--weight-regular);
    font-synthesis: none;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  @media (prefers-color-scheme: dark) {
    .page {
      --bg: #1c1917;
      --fg: #e7e5e4;
      --muted: #a8a29e;
      --rule: #3a3532;
      --logo-bg: #e7e5e4;
    }
  }
  .page ::selection {
    background: var(--fg);
    color: var(--bg);
  }
  .page a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--underline-offset);
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-10) var(--space-5) var(--space-12);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 50%;
  }

  .byline {
    margin-top: var(--section-gap);
  }
  h1 {
    margin-top: var(--space-1);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: var(--weight-bold);
    font-variation-settings: "opsz" var(--opsz-bold);
  }
  h2 {
    font-size: var(--text-title);
    line-height: var(--leading-title);
    font-weight: var(--weight-semibold);
    font-variation-settings: "opsz" var(--opsz-semibold);
  }
  p {
    margin-top: var(--space-3);
    color: var(--muted);
  }
  h1 + p {
    margin-top: var(--space-2);
  }
  section,
  footer {
    margin-top: var(--section-gap);
  }
  ul {
    margin-top: var(--space-2);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: var(--hairline);
  }
  li.row:last-child,
  li:last-child > a.row {
    border-bottom: 0;
  }
  .title {
    min-width: 0;
  }
  .meta {
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    white-space: nowrap;
  }

  /* The table above carries the same facts, so the chart is aria-hidden. */
  .chart {
    --lane: 44px;
    --logo: 32px;
    --logo-mark: 26px;
    --logo-gap: 6px;
    --bar: 18px;
    --axis: 32px;
    --dimmed: 0.35;
    --inset-x: var(--space-3);
    --inset-y: 0px;

    position: relative;
    margin-top: var(--space-6);
    padding: var(--inset-y) var(--inset-x);
    border: var(--hairline);
    border-radius: var(--radius-xl);
    corner-shape: squircle;
  }
  .grid {
    position: absolute;
    inset: 0 var(--inset-x);
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
  }
  .grid span + span {
    border-left: var(--hairline);
  }
  .lanes {
    position: relative;
    margin-top: 0;
  }
  .lane {
    position: relative;
    height: var(--lane);
  }
  .logo {
    position: absolute;
    top: calc((var(--lane) - var(--logo)) / 2);
    left: max(0px, calc(var(--left) - var(--logo) - var(--logo-gap)));
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--logo);
    height: var(--logo);
    overflow: hidden;
    border-radius: var(--radius-lg);
    corner-shape: squircle;
    background: var(--logo-bg);
    box-shadow: 0 0 0 1px var(--rule);
  }
  .logo img {
    width: var(--logo-mark);
    height: var(--logo-mark);
  }
  .bar {
    position: absolute;
    top: calc((var(--lane) - var(--bar)) / 2);
    left: var(--left);
    width: var(--width);
    height: var(--bar);
    border-radius: var(--radius-sm);
    background: var(--brand);
  }
  @media (prefers-color-scheme: dark) {
    .bar {
      background: var(--brand-dark);
    }
  }
  .lanes:hover .lane:not(:hover) .bar,
  .lanes:hover .lane:not(:hover) .logo {
    opacity: var(--dimmed);
  }
  .lane:hover {
    z-index: 2;
  }
  .card {
    position: absolute;
    top: calc(var(--lane) - var(--space-1));
    left: clamp(0px, calc(var(--left) - var(--logo) - var(--logo-gap)), calc(100% - var(--popover)));
    z-index: 1;
    display: grid;
    width: max-content;
    max-width: var(--popover);
    padding: var(--space-2) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--bg);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .lane:hover .card {
    visibility: visible;
    opacity: 1;
  }
  .card-meta {
    color: var(--muted);
  }
  .axis {
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
    height: var(--axis);
    align-items: center;
    color: var(--muted);
    font-size: var(--text-micro);
    line-height: var(--leading-micro);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bar,
    .logo {
      transition: opacity var(--duration) var(--ease);
    }
    .card {
      transition:
        opacity var(--duration) var(--ease),
        visibility 0s var(--duration);
    }
    .lane:hover .card {
      transition: opacity var(--duration) var(--ease);
    }
  }

  .scheme {
    position: relative;
    margin-left: auto;
  }
  .scheme button {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    color: var(--muted);
    cursor: help;
  }
  .scheme button:hover,
  .scheme button:focus-visible {
    color: var(--fg);
  }
  .scheme button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  .scheme svg {
    width: var(--icon);
    height: var(--icon);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    .sun {
      display: none;
    }
    .moon {
      display: block;
    }
  }
  .tip {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 1;
    width: max-content;
    max-width: min(var(--popover), calc(100vw - var(--space-10)));
    padding: var(--space-2) var(--space-3);
    border: var(--hairline);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--fg);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--duration) var(--ease),
      visibility 0s var(--duration);
  }
  .scheme:hover .tip,
  .scheme button:focus + .tip {
    visibility: visible;
    opacity: 1;
    transition: opacity var(--duration) var(--ease);
  }

  footer {
    color: var(--muted);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }
  .title a,
  a.row .title,
  .links a,
  footer a {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    text-decoration-thickness: var(--underline);
    text-decoration-color: var(--muted);
  }
  .title a:hover,
  a.row:hover .title,
  .links a:hover,
  footer a:hover {
    text-decoration-color: var(--fg);
    text-decoration-thickness: var(--underline-hover);
  }
  @media (prefers-reduced-motion: no-preference) {
    .title a,
    a.row .title,
    .links a,
    footer a {
      transition:
        text-decoration-thickness var(--duration) var(--ease),
        text-decoration-color var(--duration) var(--ease);
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--fg);
  }
  .links span {
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .row {
      flex-direction: column;
      gap: 0;
    }
    .chart {
      --inset-x: 0px;
      border: 0;
    }
  }
  @media (min-width: 640px) {
    .wrap {
      padding: var(--space-16) var(--space-8) var(--space-14);
    }
    .chart {
      --inset-x: var(--space-6);
      --inset-y: var(--space-4);
    }
  }
</style>
