---
import { Image } from "astro:assets";
import type { SvgComponent } from "astro/types";
import Moon from "../assets/icons/moon.svg";
import Sun from "../assets/icons/sun.svg";
import Layout from "@layouts/layout.astro";
import avatar from "../assets/avatar.jpg";
import { gifSizes } from "../content/gif-sizes";
import { site, type DayGif } from "../content/site";
import { formatMonthRange, formatPeriod, toYearMonth, yearsSince } from "../lib/dates";
import { gifAnimated, gifStill } from "../lib/gif";
import { previewName } from "../lib/preview";
import { barPosition, yearSpans } from "../lib/timeline";

const now = toYearMonth(new Date());
const copy = site.copy;
const years = yearsSince(site.firstJobStart, now);
const axis = yearSpans(site.firstJobStart, now);
const logos = import.meta.glob<SvgComponent>("../assets/logos/*.svg", {
  eager: true,
  import: "default",
});
const logo = (file: string) => logos[`../assets/logos/${file}`];
const shots = import.meta.glob<ImageMetadata>("../assets/previews/*.jpeg", {
  eager: true,
  import: "default",
});
const previews = new Map(
  Object.entries(shots).map(([path, src]) => [path.split("/").at(-1)!.replace(".jpeg", ""), src]),
);
const preview = (url: string) => (previews.has(previewName(url)) ? previewName(url) : undefined);
/*
 * Memes are CSS backgrounds, not <img>s: browsers never fetch a background for an element
 * that isn't rendered, so only today's meme in the current theme is downloaded.
 */
const themes = ["light", "dark"] as const;
/* The GIF review tools only exist on the dev server, never in the built site. */
const review = import.meta.env.DEV;
const gifVars = (day: DayGif) =>
  [
    `--still-light:url(${gifStill(day.light)})`,
    `--still-dark:url(${gifStill(day.dark)})`,
    `--play-light:url(${gifAnimated(day.light)})`,
    `--play-dark:url(${gifAnimated(day.dark)})`,
    `--ratio-light:${gifSizes[day.light].join("/")}`,
    `--ratio-dark:${gifSizes[day.dark].join("/")}`,
  ].join(";");
const place = (e: (typeof site.experience)[number], i: number) =>
  barPosition(e.start, e.end, site.firstJobStart, now, site.experience[i - 1]?.start);
---

<Layout
  title={site.name}
  description="Frontend-focused product engineer. I make screens you can leave: the best interfaces get you what you need, then let you go."
>
  <div class="page">
    <div class="wrap">
      <header class="head">
        <button type="button" class="avatar-open" aria-label={copy.avatar.open} data-avatar-open>
          <Image
            class="avatar"
            src={avatar}
            alt=""
            width={56}
            height={56}
            densities={[1, 2]}
            loading="eager"
          />
        </button>
        <dialog class="portrait" aria-label={site.name} closedby="any" data-avatar-dialog>
          <Image class="portrait-img" src={avatar} alt={site.name} width={256} height={256} />
          <form method="dialog">
            <button type="submit" class="portrait-close" aria-label={copy.avatar.close}>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </button>
          </form>
        </dialog>
        <span class="scheme">
          <button type="button" aria-label={copy.theme.label} aria-pressed="false" data-theme-toggle>
            <span class="sky">
            <span class="body sun">
              <Sun aria-hidden="true" />
            </span>
            <span class="body moon">
              <Moon aria-hidden="true" />
            </span>
            </span>
          </button>
          <span class="tip" aria-hidden="true">
            <span class="light-only">{copy.theme.toDark}</span>
            <span class="dark-only">{copy.theme.toLight}</span>
          </span>
        </span>
      </header>

      <main>
        <p class="byline">{site.name}</p>
        <h1>{copy.headline.text} <em>{copy.headline.emphasis}</em>.</h1>
        {copy.intro.map((p) => <p>{p}</p>)}
        <p>{copy.facts(years)}</p>

        <section>
          <h2>{copy.sections.experience}</h2>
          <div class="chart">
            <div class="grid" aria-hidden="true">
              {axis.slice(1).map((y) => (
                <span style={`--left:${y.left}%`} />
              ))}
            </div>
            <div class="plot" aria-hidden="true">
              <ul class="lanes">
                {
                  site.experience.map((e, i) => {
                    const { left, width } = place(e, i);
                    const Logo = logo(e.logo);
                    return (
                      <li
                        class="lane"
                        style={`--left:${left}%;--width:${width}%;--brand:${e.color};--brand-dark:${e.colorDark ?? e.color}`}
                      >
                        <span class="segment" />
                        <span class="card">
                          <span class="card-logo">
                            <Logo width={20} height={20} aria-hidden="true" />
                          </span>
                          <span class="card-text">
                            <span class="card-title">
                              {e.role} at {e.company}
                              {e.client && ` for ${e.client.name}`}
                            </span>
                            <span class="card-meta">{formatMonthRange(e.start, e.end, now)}</span>
                          </span>
                        </span>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
            <div class="axis" aria-hidden="true">
              {axis.map((y) => (
                <span style={`--left:${y.left + y.width / 2}%`}>{y.year}</span>
              ))}
            </div>
          </div>
          <ul>
            {
              site.experience.map((e) => (
                <li class="row">
                  <span class="title">
                    {e.role} at{" "}
                    <a href={e.url} target="_blank" rel="noopener" data-preview={preview(e.url)}>
                      {e.company}
                    </a>
                    {e.client && (
                      <>
                        {" "}
                        for{" "}
                        <a
                          href={e.client.url}
                          target="_blank"
                          rel="noopener"
                          data-preview={preview(e.client.url)}
                        >
                          {e.client.name}
                        </a>
                      </>
                    )}
                  </span>
                  <span class="meta">{formatPeriod(e.start, e.end, now)}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{copy.sections.projects}</h2>
          <ul>
            {
              site.projects.map((p) => (
                <li>
                  <a class="row" href={p.repo} target="_blank" rel="noopener">
                    <span class="title">{p.title}</span>
                    <span class="meta">{p.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <p class="links">
            {
              site.links.map((l) => (
                <a class="cta" href={l.href} target="_blank" rel="noopener">
                  <span class="cta-gif" aria-hidden="true">
                    {l.gifs.map((day, d) => (
                      <span class={`shot day day-${d}`} style={gifVars(day)} />
                    ))}
                  </span>
                  <span class="cta-card" aria-hidden="true">
                    {l.gifs.map((day, d) => (
                      <span class={`shot day day-${d}`} style={gifVars(day)} />
                    ))}
                  </span>
                  {l.label}
                </a>
              ))
            }
          </p>
          <p class="pack-open-row">
            <button type="button" class="pack-open" data-pack-open>
              {copy.pack.open}
            </button>
          </p>
          <dialog class="pack" aria-labelledby="pack-title" data-pack>
            <header class="pack-head">
              <div>
                <h2 id="pack-title" class="pack-title">{copy.pack.title}</h2>
                <p class="pack-lede">{copy.pack.lede}</p>
              </div>
              <form method="dialog">
                <button type="submit" class="dialog-close" aria-label={copy.pack.close}>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path
                      d="M4 4l8 8M12 4l-8 8"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
              </form>
            </header>
            <div class="pack-track" data-pack-track></div>
            <nav class="pack-nav">
              <button type="button" aria-label={copy.pack.prev} data-pack-prev>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M10 3.5 5.5 8l4.5 4.5" />
                </svg>
              </button>
              <span class="pack-dots">
                {[1, 2, 3, 4, 5, 6, 0].map((d, i) => (
                  <button type="button" aria-label={copy.pack.days[d]} data-pack-dot={i} />
                ))}
              </span>
              <button type="button" aria-label={copy.pack.next} data-pack-next>
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="m6 3.5 4.5 4.5L6 12.5" />
                </svg>
              </button>
            </nav>
            <template data-pack-items>
              {[1, 2, 3, 4, 5, 6, 0].map((d) => (
                <section class={`pack-slide pack-day-${d}`} data-day={d}>
                  <h3 class="pack-slide-head">
                    {copy.pack.days[d]}
                    <span class="pack-today">{copy.pack.today}</span>
                  </h3>
                  <div class="pack-quad">
                    {site.links.flatMap((l) =>
                      themes.map((theme) => (
                        <figure
                          class="pack-item"
                          data-key={`${copy.pack.days[d]} · ${copy.pack.themes[theme]} · ${l.tag}`}
                        >
                          {review && (
                            <button
                              type="button"
                              class="pack-mark"
                              aria-pressed="false"
                              aria-label={`${copy.pack.days[d]} · ${copy.pack.themes[theme]} · ${l.tag}`}
                              data-mark
                            />
                          )}
                          <picture>
                            <source
                              media="(prefers-reduced-motion: no-preference)"
                              srcset={gifAnimated(l.gifs[d][theme])}
                              type="image/webp"
                            />
                            <img
                              src={gifStill(l.gifs[d][theme])}
                              alt={`A ${theme === "light" ? "dog" : "cat"} ${l.meme}`}
                              width={gifSizes[l.gifs[d][theme]][0]}
                              height={gifSizes[l.gifs[d][theme]][1]}
                              loading="lazy"
                            />
                          </picture>
                          <figcaption>
                            {copy.pack.themes[theme]} · {l.tag}
                          </figcaption>
                        </figure>
                      )),
                    )}
                  </div>
                </section>
              ))}
            </template>
            {
              review && (
                <footer class="pack-review" data-pack-review>
                  <span>
                    {copy.pack.review.hint} <strong data-count>0</strong> {copy.pack.review.marked}
                  </span>
                  <span class="pack-review-actions">
                    <button type="button" data-review-clear>
                      {copy.pack.review.clear}
                    </button>
                    <button
                      type="button"
                      class="pack-review-copy"
                      data-review-copy
                      data-copied={copy.pack.review.copied}
                      data-request={copy.pack.review.request}
                    >
                      {copy.pack.review.copy}
                    </button>
                  </span>
                </footer>
              )
            }
          </dialog>
        </section>
      </main>

      <div class="site-preview" aria-hidden="true" data-preview-card>
        <span class="site-preview-shot">
          {
            [...previews].map(([name, src]) => (
              <Image
                src={src}
                alt=""
                width={320}
                densities={[1, 2]}
                format="webp"
                quality={75}
                loading="lazy"
                decoding="async"
                data-shot={name}
              />
            ))
          }
        </span>
        <span class="site-preview-host"></span>
      </div>

      <footer>
        {
          copy.footer.map((f) => (
            <>
              {f.label}{" "}
              <a href={f.link.href} target="_blank" rel="noopener">
                {f.link.label}
              </a>
            </>
          ))
        }
        .
      </footer>
    </div>
  </div>
</Layout>

<script>
  import { previewHost } from "../lib/preview";

  const card = document.querySelector<HTMLElement>("[data-preview-card]");
  const host = card?.querySelector<HTMLElement>(".site-preview-host");
  if (card && host && matchMedia("(hover: hover)").matches) {
    const GAP = 12;
    const EDGE = 8;
    /* Every screenshot is a lazy <img> kept out of layout, so only the ones shown get fetched. */
    const shots = new Map(
      [...card.querySelectorAll<HTMLImageElement>("img[data-shot]")].map((img) => [img.dataset.shot, img]),
    );
    const hide = () => card.removeAttribute("data-show");
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-preview]")) {
      link.addEventListener("pointerenter", () => {
        const shot = shots.get(link.dataset.preview);
        if (!shot) return;
        for (const img of shots.values()) img.toggleAttribute("data-active", img === shot);
        const loaded = shot.complete && shot.naturalWidth > 0;
        card.toggleAttribute("data-loaded", loaded);
        card.removeAttribute("data-failed");
        if (!loaded) {
          shot.addEventListener("load", () => card.toggleAttribute("data-loaded", shot.hasAttribute("data-active")), { once: true });
          shot.addEventListener("error", () => card.toggleAttribute("data-failed", shot.hasAttribute("data-active")), { once: true });
        }
        host.textContent = previewHost(link.href);
        const box = link.getBoundingClientRect();
        const { width, height } = card.getBoundingClientRect();
        const left = Math.min(
          Math.max(EDGE, box.left + box.width / 2 - width / 2),
          innerWidth - width - EDGE,
        );
        const above = box.top - height - GAP >= EDGE;
        card.style.left = `${left}px`;
        card.style.top = `${above ? box.top - height - GAP : box.bottom + GAP}px`;
        card.dataset.side = above ? "above" : "below";
        card.toggleAttribute("data-show", true);
      });
      link.addEventListener("pointerleave", hide);
    }
    addEventListener("scroll", hide, { passive: true });
  }

  if (!matchMedia("(hover: hover)").matches) {
    const lanes = [...document.querySelectorAll<HTMLElement>(".lane")];
    addEventListener("click", (event) => {
      const hit = (event.target as Element).closest<HTMLElement>(".lane");
      for (const lane of lanes) lane.toggleAttribute("data-open", lane === hit && !lane.hasAttribute("data-open"));
    });
  }

  const pack = document.querySelector<HTMLDialogElement>("[data-pack]");
  const track = pack?.querySelector<HTMLElement>("[data-pack-track]");
  const dots = [...(pack?.querySelectorAll<HTMLElement>("[data-pack-dot]") ?? [])];
  const prev = pack?.querySelector<HTMLButtonElement>("[data-pack-prev]");
  const next = pack?.querySelector<HTMLButtonElement>("[data-pack-next]");
  const WEEK = [1, 2, 3, 4, 5, 6, 0];
  const current = () => (track ? Math.round(track.scrollLeft / track.clientWidth) : 0);
  const showDay = (index: number, smooth = true) => {
    if (!track) return;
    const i = Math.max(0, Math.min(WEEK.length - 1, index));
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    track.scrollTo({ left: i * track.clientWidth, behavior: smooth && !still ? "smooth" : "instant" });
  };
  const syncNav = () => {
    const i = current();
    dots.forEach((dot, d) => dot.toggleAttribute("aria-current", d === i));
    if (prev) prev.disabled = i === 0;
    if (next) next.disabled = i === WEEK.length - 1;
  };
  track?.addEventListener("scroll", () => requestAnimationFrame(syncNav), { passive: true });
  prev?.addEventListener("click", () => showDay(current() - 1));
  next?.addEventListener("click", () => showDay(current() + 1));
  dots.forEach((dot, d) => dot.addEventListener("click", () => showDay(d)));
  pack?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") showDay(current() - 1);
    if (event.key === "ArrowRight") showDay(current() + 1);
  });
  document.querySelector("[data-pack-open]")?.addEventListener("click", () => {
    const items = pack?.querySelector<HTMLTemplateElement>("[data-pack-items]");
    if (track && items && !track.childElementCount) track.append(items.content.cloneNode(true));
    pack?.showModal();
    showDay(WEEK.indexOf(Number(document.documentElement.dataset.day ?? 1)), false);
    syncNav();
  });
  pack?.addEventListener("click", (event) => {
    if (event.target === pack) pack.close();
  });

  const reviewBar = pack?.querySelector<HTMLElement>("[data-pack-review]");
  if (pack && reviewBar) {
    const KEY = "pack-marks";
    const load = (): string[] => {
      try {
        return JSON.parse(localStorage.getItem(KEY) ?? "[]");
      } catch {
        return [];
      }
    };
    let marks = new Set(load());
    const sync = () => {
      for (const item of pack.querySelectorAll<HTMLElement>(".pack-item")) {
        const on = marks.has(item.dataset.key!);
        item.toggleAttribute("data-marked", on);
        item.querySelector("[data-mark]")?.setAttribute("aria-pressed", String(on));
      }
      reviewBar.querySelector("[data-count]")!.textContent = String(marks.size);
      try {
        localStorage.setItem(KEY, JSON.stringify([...marks]));
      } catch {}
    };
    document.querySelector("[data-pack-open]")?.addEventListener("click", sync);
    pack.addEventListener("click", (event) => {
      const mark = (event.target as Element).closest<HTMLElement>("[data-mark]");
      if (!mark) return;
      const key = mark.closest<HTMLElement>(".pack-item")!.dataset.key!;
      if (!marks.delete(key)) marks.add(key);
      sync();
    });
    reviewBar.querySelector("[data-review-clear]")?.addEventListener("click", () => {
      marks = new Set();
      sync();
    });
    const copyButton = reviewBar.querySelector<HTMLButtonElement>("[data-review-copy]")!;
    const label = copyButton.textContent;
    copyButton.addEventListener("click", async () => {
      const template = pack.querySelector<HTMLTemplateElement>("[data-pack-items]")!;
      const order = [...template.content.querySelectorAll<HTMLElement>(".pack-item")].map(
        (i) => i.dataset.key!,
      );
      const lines = order.filter((key) => marks.has(key)).map((key) => `* ${key}`);
      await navigator.clipboard.writeText([copyButton.dataset.request, ...lines].join("\n"));
      copyButton.textContent = copyButton.dataset.copied!;
      setTimeout(() => (copyButton.textContent = label), 1500);
    });
  }

  const portrait = document.querySelector<HTMLDialogElement>("[data-avatar-dialog]");
  document.querySelector("[data-avatar-open]")?.addEventListener("click", () => portrait?.showModal());
  portrait?.addEventListener("click", () => portrait.close());

  const toggle = document.querySelector<HTMLElement>("[data-theme-toggle]");
  const sky = toggle?.querySelector<HTMLElement>(".sky");
  if (
    toggle &&
    sky &&
    matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches
  ) {
    toggle.addEventListener("pointermove", (event) => {
      const box = sky.getBoundingClientRect();
      const tx = ((event.clientX - box.left) / box.width - 0.5) * 2;
      const ty = ((event.clientY - box.top) / box.height - 0.5) * 2;
      sky.style.setProperty("--tx", String(Math.max(-1, Math.min(1, tx))));
      sky.style.setProperty("--ty", String(Math.max(-1, Math.min(1, ty))));
    });
    toggle.addEventListener("pointerleave", () => {
      sky.style.removeProperty("--tx");
      sky.style.removeProperty("--ty");
    });
  }
</script>


<style>
  .page {
    /* Color */
    --bg: light-dark(#faf7f0, #0e131b); /* Background */
    --fg: light-dark(#231f17, #dfe6f1); /* Foreground */
    --muted: light-dark(#756b57, #909fb6);
    --rule: light-dark(#e7e1d5, #252d39);
    --logo-bg: light-dark(#fff, #dfe6f1);

    /* Font face */
    --font: "Inter Variable", system-ui, sans-serif;
    --font-heading: "Averia Serif Libre", Georgia, serif;

    /* Font size scale: Minor Third (factor of 1.2) - typescale.com */
    --text-display: 2.986rem; /* h1 */
    --text-body: 1rem; /* p */
    --text-caption: 0.833rem; /* small */
    --text-micro: 0.694rem;

    /* Vertical rhythm: open leading for text, tight for headings */
    --leading-text: 1.6;
    --leading-heading: 1.2;
    --weight-regular: 400;
    --weight-medium: 500;
    --weight-bold: 700;
    --opsz-regular: 14;
    --opsz-bold: 25;

    /* Spacing on a 4px grid */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;
    --space-12: 48px;
    --space-14: 56px;
    --space-16: 64px;
    /* Space between blocks: body line height / 1.5, on the 4px grid */
    --flow: var(--space-4);
    /* Space before a section heading: twice the flow, three times on wider screens */
    --section-gap: calc(var(--flow) * 2);

    /* Lines */
    --hairline: 1px solid var(--rule);
    --focus-ring: 1px solid var(--fg);
    --focus-offset: 2px;
    --underline: 1px;
    --underline-hover: 2px;
    --underline-offset: 3px;

    /* Shape */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 16px;
    --radius-pill: 999px;

    /* Sizes */
    --measure: 640px;
    --avatar: 56px;
    --portrait: 256px;
    --tap: 64px;
    --icon: 56px;
    --popover: 240px;
    --preview: 320px;
    --gif: 200px;
    --cta-shot: 64px;
    --cta-cut: 16px;

    /* Motion */
    --duration: 150ms;
    --ease: ease-out;

    position: relative;
    isolation: isolate;
    overflow-x: clip;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font);
    font-variation-settings: "opsz" var(--opsz-regular);
    font-weight: var(--weight-regular);
    font-synthesis: none;
    font-size: var(--text-body);
    line-height: var(--leading-text);
  }
  .page ::selection {
    background: var(--fg);
    color: var(--bg);
  }
  .page a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-10) var(--space-5) var(--space-12);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 30%;
    corner-shape: squircle;
  }
  .avatar-open {
    border-radius: 30%;
    corner-shape: squircle;
    cursor: zoom-in;
  }
  .avatar-open:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  /* The dialog sits in the top layer, so it carries its own colours from the page tokens. */
  .portrait {
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: var(--fg);
  }
  .portrait::backdrop,
  .pack::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(4px);
  }
  .portrait-img {
    width: min(var(--portrait), calc(100vw - var(--space-10)));
    height: auto;
    border-radius: 30%;
    corner-shape: squircle;
    cursor: zoom-out;
  }
  .portrait-close {
    position: absolute;
