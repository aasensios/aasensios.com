---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@layouts/layout.astro";
import avatar from "../assets/avatar.jpg";
import { site } from "../content/site";
import { formatPeriodMonths, toYearMonth, yearsSince } from "../lib/dates";
import { axisYears, barPosition } from "../lib/timeline";

const now = toYearMonth(new Date());
const copy = site.copy;
const years = yearsSince(site.firstJobStart, now);
const axis = axisYears(site.firstJobStart.year, now);
const logos = import.meta.glob<{ default: ImageMetadata }>("../assets/logos/*", { eager: true });
const logo = (file: string) => logos[`../assets/logos/${file}`].default;
---

<Layout
  title={site.name}
  description="Frontend-focused product engineer. I make screens you can leave: the best interfaces get you what you need, then let you go."
>
  <div class="mn">
    <div class="wrap">
      <header class="head">
        <Image
          class="avatar"
          src={avatar}
          alt=""
          width={56}
          height={56}
          densities={[1, 2]}
          loading="eager"
        />
        <span class="name">{site.name}</span>
        <span class="scheme">
          <button type="button" aria-label="Light and dark mode" aria-describedby="scheme-tip">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
            </svg>
          </button>
          <span class="tip" role="tooltip" id="scheme-tip">{copy.colorScheme}</span>
        </span>
      </header>

      <main>
        <h1>{copy.headline}</h1>
        {copy.intro.map((p) => <p>{p}</p>)}
        <p>{copy.facts(years)}</p>

        <section>
          <h2>{copy.sections.experience}</h2>
          <ul>
            {
              site.experience.map((e) => (
                <li class="row">
                  <span class="title">
                    {e.role} at{" "}
                    <a href={e.url} target="_blank" rel="noopener">
                      {e.company}
                    </a>
                    {e.client && (
                      <>
                        {" "}
                        for{" "}
                        <a href={e.client.url} target="_blank" rel="noopener">
                          {e.client.name}
                        </a>
                      </>
                    )}
                  </span>
                  <span class="meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                </li>
              ))
            }
          </ul>
          <div class="chart" style={`--years:${axis.length}`} aria-hidden="true">
            <div class="grid">
              {axis.map(() => (
                <span />
              ))}
            </div>
            <ul class="lanes">
              {
                site.experience.map((e, i) => {
                  // Experience is newest first, so the job that came next is the previous one.
                  const next = site.experience[i - 1];
                  const { left, width } = barPosition(
                    e.start,
                    e.end,
                    site.firstJobStart.year,
                    now,
                    next?.start,
                  );
                  return (
                    <li
                      class="lane"
                      style={`--left:${left}%;--width:${width}%;--c:${e.color};--cd:${e.colorDark ?? e.color}`}
                    >
                      <span class="logo">
                        <Image
                          src={logo(e.logo)}
                          alt=""
                          width={26}
                          height={26}
                          densities={[1, 2]}
                          loading="eager"
                        />
                      </span>
                      <span class="bar" />
                      <span class="card">
                        <span class="card-title">
                          {e.role} at {e.company}
                          {e.client && ` for ${e.client.name}`}
                        </span>
                        <span class="card-meta">{formatPeriodMonths(e.start, e.end, now)}</span>
                      </span>
                    </li>
                  );
                })
              }
            </ul>
            <div class="axis">
              {axis.map((y) => (
                <span>{y}</span>
              ))}
            </div>
          </div>
        </section>

        <section>
          <h2>{copy.sections.projects}</h2>
          <ul>
            {
              site.projects.map((p) => (
                <li>
                  <a class="row" href={p.repo} target="_blank" rel="noopener">
                    <span class="title">{p.title}</span>
                    <span class="meta">{p.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2>{copy.sections.links}</h2>
          <p class="links">
            {
              site.links.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">/</span>}
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                </>
              ))
            }
          </p>
        </section>
      </main>

      <footer>
        {
          copy.footer.map((f) => (
            <>
              {f.label}{" "}
              <a href={f.link.href} target="_blank" rel="noopener">
                {f.link.label}
              </a>
            </>
          ))
        }
      </footer>
    </div>
  </div>
</Layout>

<style>
  .mn {
    --bg: #fdfcfa;
    --fg: #1c1917;
    --muted: #78716c;
    --rule: #e7e5e4;

    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: "Inter Variable", system-ui, sans-serif;
    font-variation-settings: "opsz" 14;
    font-weight: 400;
    font-synthesis: none;
    font-size: 16px;
    line-height: 24px;
  }
  @media (prefers-color-scheme: dark) {
    .mn {
      --bg: #1c1917;
      --fg: #e7e5e4;
      --muted: #a8a29e;
      --rule: #3a3532;
    }
  }
  .mn ::selection {
    background: var(--fg);
    color: var(--bg);
  }
  .mn a:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 3px;
  }

  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 40px 20px 48px;
    box-sizing: border-box;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
  }

  h1 {
    font-size: 32px;
    line-height: 40px;
    font-weight: 700;
    font-variation-settings: "opsz" 25;
    margin: 48px 0 0;
  }
  h2 {
    font-size: 20px;
    line-height: 28px;
    font-weight: 550;
    font-variation-settings: "opsz" 18;
    margin: 0;
  }
  p {
    margin: 12px 0 0;
    color: var(--muted);
  }
  h1 + p {
    margin-top: 8px;
  }
  section {
    margin-top: 48px;
  }
  ul {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  li.row:last-child,
  li:last-child > a.row {
    border-bottom: 0;
  }
  .title {
    min-width: 0;
  }
  /* The table above carries the same facts, so the chart is aria-hidden. */
  .chart {
    position: relative;
    margin-top: 24px;
    padding: 0 12px;
    border: 1px solid var(--rule);
    border-radius: 16px;
    corner-shape: squircle;
  }
  .grid {
    position: absolute;
    inset: 0 12px;
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
  }
  .grid span + span {
    border-left: 1px solid var(--rule);
  }
  .lanes {
    position: relative;
    margin: 0;
  }
  .lane {
    position: relative;
    height: 44px;
  }
  .logo {
    position: absolute;
    top: 6px;
    left: max(0px, calc(var(--left) - 38px));
    z-index: 1;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    overflow: hidden;
    border-radius: 10px;
    corner-shape: squircle;
    background: #fff;
    box-shadow: 0 0 0 1px var(--rule);
  }
  .logo img {
    width: 26px;
    height: 26px;
  }
  .bar {
    position: absolute;
    top: 13px;
    left: var(--left);
    width: var(--width);
    height: 18px;
    border-radius: 4px;
    background: var(--c);
  }
  @media (prefers-color-scheme: dark) {
    .bar {
      background: var(--cd);
    }
    .logo {
      background: #e7e5e4;
    }
  }
  .lanes:hover .lane:not(:hover) .bar,
  .lanes:hover .lane:not(:hover) .logo {
    opacity: 0.35;
  }
  .lane:hover {
    z-index: 2;
  }
  .card {
    position: absolute;
    top: 40px;
    left: clamp(0px, calc(var(--left) - 38px), calc(100% - 240px));
    z-index: 1;
    display: grid;
    width: max-content;
    max-width: 240px;
    padding: 8px 12px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
    font-size: 14px;
    line-height: 20px;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .lane:hover .card {
    visibility: visible;
    opacity: 1;
  }
  .card-meta {
    color: var(--muted);
  }
  .axis {
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
    height: 32px;
    align-items: center;
    color: var(--muted);
    font-size: 12px;
    line-height: 16px;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bar,
    .logo {
      transition: opacity 150ms ease-out;
    }
    .card {
      transition:
        opacity 150ms ease-out,
        visibility 0s 150ms;
    }
    .lane:hover .card {
      transition: opacity 150ms ease-out;
    }
  }
  .scheme {
    position: relative;
    margin-left: auto;
  }
  .scheme button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: help;
  }
  .scheme button:hover,
  .scheme button:focus-visible {
    color: var(--fg);
  }
  .scheme button:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 2px;
  }
  .scheme svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    .sun {
      display: none;
    }
    .moon {
      display: block;
    }
  }
  .tip {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 1;
    width: max-content;
    max-width: min(240px, calc(100vw - 40px));
    box-sizing: border-box;
    padding: 8px 12px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font-size: 14px;
    line-height: 20px;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 150ms ease-out,
      visibility 0s 150ms;
  }
  .scheme:hover .tip,
  .scheme button:focus + .tip {
    visibility: visible;
    opacity: 1;
    transition: opacity 150ms ease-out;
  }
  footer {
    margin-top: 48px;
    color: var(--muted);
    font-size: 14px;
    line-height: 20px;
  }
  .title a,
  a.row .title,
  .links a,
  footer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--muted);
  }
  .title a:hover,
  a.row:hover .title,
  .links a:hover,
  footer a:hover {
    text-decoration-color: var(--fg);
    text-decoration-thickness: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .title a,
    a.row .title,
    .links a,
    footer a {
      transition:
        text-decoration-thickness 150ms ease-out,
        text-decoration-color 150ms ease-out;
    }
  }
  .meta {
    color: var(--muted);
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
    color: var(--fg);
  }
  .links span {
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .row {
      flex-direction: column;
      gap: 0;
    }
  }
  @media (min-width: 640px) {
    .wrap {
      padding: 64px 32px 56px;
    }
  }
</style>
