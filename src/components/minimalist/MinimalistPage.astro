---
import StyleToggle from "@components/StyleToggle.astro";
import { experienceLabel, site } from "../../content/site";
import { formatPeriod, toYearMonth } from "../../lib/dates";

const now = toYearMonth(new Date());
const copy = site.copy.minimalist;
---

<div class="mn">
  <div class="wrap">
    <header class="head">
      <span class="name">{site.name}</span>
      <StyleToggle variant="minimalist" />
    </header>

    <main>
      <h1>{copy.headline}</h1>
      {copy.paragraphs.map((p) => <p>{p}</p>)}

      <section>
        <h2>{copy.sections.experience}</h2>
        <ul>
          {
            site.experience.map((e) => (
              <li class="row">
                <span>{experienceLabel(e)}</span>
                <span class="meta">{formatPeriod(e.start, e.end, now)}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>{copy.sections.stack}</h2>
        <p class="stack">{site.stack.map((t) => t.name).join(", ")}</p>
      </section>

      <section>
        <h2>{copy.sections.projects}</h2>
        <ul>
          {
            site.projects.map((p) => (
              <li>
                <a class="row" href={p.repo}>
                  <span>{p.title}</span>
                  <span class="meta">{p.year}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>{copy.sections.links}</h2>
        <p class="links">
          {
            site.links.map((l, i) => (
              <>
                {i > 0 && <span aria-hidden="true">/</span>}
                <a href={l.href}>{l.label}</a>
              </>
            ))
          }
        </p>
      </section>
    </main>
  </div>
</div>

<style>
  .mn {
    --bg: #fdfcfa;
    --fg: #1c1917;
    --body: #44403c;
    --muted: #a8a29e;
    --rule: #e7e5e4;
    --sans: system-ui, -apple-system, "Segoe UI", sans-serif;

    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif;
    font-size: 16px;
    line-height: 1.6;
  }
  @media (prefers-color-scheme: dark) {
    .mn {
      --bg: #1c1917;
      --fg: #e7e5e4;
      --body: #d6d3d1;
      --muted: #a8a29e;
      --rule: #3a3532;
    }
  }

  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 20px 48px;
    box-sizing: border-box;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .name {
    font-size: 17px;
  }
  .mn :global(.style-toggle) {
    display: inline-flex;
    gap: 14px;
  }
  .mn :global(.style-toggle button) {
    border: 0;
    padding: 0;
    background: none;
    color: var(--muted);
    font: 13px/1.6 var(--sans);
  }
  .mn :global(.style-toggle button[aria-pressed="true"]) {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .mn :global(.style-toggle button:focus-visible) {
    outline: 1px solid var(--fg);
    outline-offset: 3px;
  }

  h1 {
    font-weight: 400;
    font-size: clamp(22px, 5.5vw, 28px);
    line-height: 1.3;
    margin: 48px 0 18px;
    max-width: 22em;
  }
  p {
    margin: 0 0 14px;
    color: var(--body);
    max-width: 36em;
  }
  section {
    margin-top: 40px;
  }
  h2 {
    font: 500 13px/1.4 var(--sans);
    color: var(--muted);
    margin: 0 0 6px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  a.row:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .meta {
    color: var(--muted);
    font: 13px/1.6 var(--sans);
    white-space: nowrap;
  }
  .stack {
    color: var(--fg);
    margin: 6px 0 0;
  }
  .links {
    display: flex;
    gap: 12px;
    margin: 0;
  }
  .links span {
    color: var(--muted);
  }
  .links a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 480px) {
    .row {
      flex-direction: column;
      gap: 0;
    }
  }
  @media (min-width: 640px) {
    .wrap {
      padding: 64px 32px 56px;
    }
    h1 {
      margin-top: 56px;
    }
  }
</style>
