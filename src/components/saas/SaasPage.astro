---
import StyleToggle from "@components/StyleToggle.astro";
import Blog from "@components/illustrations/blog.astro";
import Dna from "@components/illustrations/dna.astro";
import Forms from "@components/illustrations/forms.astro";
import Gmail from "@components/illustrations/gmail.astro";
import { site } from "../../content/site";
import { toYearMonth, yearsSince } from "../../lib/dates";
import ExperienceTimeline from "./ExperienceTimeline.astro";

const now = toYearMonth(new Date());
const copy = site.copy.saas;
const illustrations = { forms: Forms, gmail: Gmail, blog: Blog, dna: Dna };
---

<div class="sa">
  <header class="top">
    <div class="inner">
      <span class="me">
        <img src={site.avatar} alt="" width="26" height="26" />
        {site.name}
      </span>
      <StyleToggle variant="saas" />
    </div>
  </header>

  <main class="wrap">
    <section class="sec intro">
      <h1>{copy.headline}</h1>
      <p class="muted">{copy.subline}</p>
      <p class="text">{copy.intro(yearsSince(site.firstJobStart, now))}</p>
    </section>

    <section class="sec">
      <h2>{copy.sections.experience}</h2>
      <ExperienceTimeline experience={site.experience} now={now} firstYear={2019} />
    </section>

    <section class="sec">
      <h2>{copy.sections.stack}</h2>
      <ul class="stack">
        {
          site.stack.map((t) => (
            <li>
              <img
                src={t.logo}
                alt=""
                width="24"
                height="24"
                class:list={{ "dark-invert": t.invertOnDark }}
              />
              {t.name}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec">
      <h2>{copy.sections.projects}</h2>
      <ul class="projects">
        {
          site.projects.map((p) => {
            const Illustration = illustrations[p.illustration];
            return (
              <li>
                <a href={p.repo} target="_blank" rel="noopener">
                  <Illustration class="ill" />
                  <span class="body">
                    <b>{p.title}</b>
                    <span class="muted">{p.description}</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="sec">
      <h2>{copy.sections.links}</h2>
      <p class="links">
        {
          site.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              <img
                src={l.logo}
                alt=""
                width="18"
                height="18"
                class:list={{ "dark-invert": l.label === "GitHub" }}
              />
              {l.label}
            </a>
          ))
        }
      </p>
    </section>
  </main>
</div>

<style>
  .sa {
    --bg: #fff;
    --fg: #09090b;
    --muted: #71717a;
    --faint: #a1a1aa;
    --border: #e4e4e7;
    --divider: #f0f0f2;
    --track: #f4f4f5;
    --grid: #ececef;
    --chip: #f4f4f5;

    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }
  @media (prefers-color-scheme: dark) {
    .sa {
      --bg: #09090b;
      --fg: #fafafa;
      --muted: #a1a1aa;
      --faint: #71717a;
      --border: #27272a;
      --divider: #1f1f23;
      --track: #1f1f23;
      --grid: #1c1c20;
      --chip: #18181b;
    }
    .dark-invert {
      filter: invert(1) hue-rotate(180deg);
    }
    .projects :global(.ill) {
      filter: brightness(0.92);
    }
  }

  .sa a {
    color: inherit;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Top bar: full-width border, contents aligned with the content column. */
  .top {
    border-bottom: 1px solid var(--border);
  }
  .inner,
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 16px;
    box-sizing: border-box;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 12px;
  }
  .me {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }
  .me img {
    border-radius: 999px;
  }
  .sa :global(.style-toggle) {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--chip);
  }
  .sa :global(.style-toggle button) {
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font: 500 12px/1.4 system-ui, sans-serif;
    padding: 4px 10px;
  }
  .sa :global(.style-toggle button[aria-pressed="true"]) {
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 1px 2px #0002;
  }
  .sa :global(.style-toggle button:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 1px;
  }

  /* Sections */
  .wrap {
    padding-block: 32px 24px;
  }
  .sec {
    padding-block: 22px;
    border-bottom: 1px solid var(--divider);
  }
  .sec:first-child {
    padding-top: 0;
  }
  .sec:last-child {
    border-bottom: 0;
  }
  h1 {
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 2px;
  }
  h2 {
    font-size: 14px;
    margin: 0 0 14px;
  }
  .muted {
    color: var(--muted);
  }
  .intro p {
    margin: 0;
  }
  .intro .text {
    margin-top: 14px;
    max-width: 46em;
  }

  .stack {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 24px;
  }
  .stack li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .projects a {
    display: block;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
  }
  .projects a:hover {
    border-color: var(--faint);
  }
  .projects :global(.ill) {
    display: block;
    width: 100%;
    height: auto;
  }
  .body {
    display: grid;
    gap: 2px;
    padding: 10px 12px 12px;
    border-top: 1px solid var(--border);
  }

  .links {
    display: flex;
    gap: 20px;
    margin: 0;
    font-weight: 500;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
  }
  .links a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 420px) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 640px) {
    .inner,
    .wrap {
      padding-inline: 32px;
    }
    .wrap {
      padding-top: 36px;
    }
    .stack {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  @media (min-width: 900px) {
    .projects {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
