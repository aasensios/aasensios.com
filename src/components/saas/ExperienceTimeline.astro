---
import { experienceLabel, type Experience } from "../../content/site";
import { formatDuration, monthsBetween, type YearMonth } from "../../lib/dates";
import { axisYears, barPosition } from "../../lib/timeline";

interface Props {
  experience: Experience[];
  now: YearMonth;
  firstYear: number;
}

const { experience, now, firstYear } = Astro.props;
const years = axisYears(firstYear, now);
---

<div class="tl" style={`--years:${years.length}`}>
  <div class="gridlines" aria-hidden="true"></div>
  <ul>
    {
      experience.map((e) => {
        const { left, width } = barPosition(e.start, e.end, firstYear, now);
        return (
          <li class="row">
            <span class="tile">
              <img
                src={e.icon}
                alt=""
                width="24"
                height="24"
                style={e.iconScale ? `transform:scale(${e.iconScale})` : undefined}
              />
            </span>
            <span class="label">
              <span>{experienceLabel(e)}</span>
              <span class="duration">{formatDuration(monthsBetween(e.start, e.end ?? now))}</span>
            </span>
            <span class="track" aria-hidden="true">
              <span
                class="bar"
                style={`left:${left}%;width:${width}%;--c:${e.color};--cd:${e.colorDark ?? e.color}`}
              />
            </span>
          </li>
        );
      })
    }
  </ul>
  <div class="row axis" aria-hidden="true">
    <span></span>
    <span class="years">{years.map((y) => <span>{y}</span>)}</span>
  </div>
</div>

<style>
  .tl {
    --tile: 28px;
    --gap: 14px;
    --label: 380px;
    --track-left: calc(var(--tile) + var(--gap));
    position: relative;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .row {
    display: grid;
    grid-template-columns: var(--tile) 1fr;
    column-gap: var(--gap);
    row-gap: 6px;
    align-items: center;
  }
  .tile {
    grid-row: span 2;
    width: var(--tile);
    height: var(--tile);
    border-radius: 7px;
    background: #fff;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .tile img {
    width: 24px;
    height: 24px;
    border-radius: 4px;
  }
  .label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .duration {
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .track {
    position: relative;
    height: 5px;
    border-radius: 999px;
    background: var(--track);
  }
  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: var(--c);
  }
  @media (prefers-color-scheme: dark) {
    .bar {
      background: var(--cd);
    }
  }
  .gridlines {
    position: absolute;
    top: -6px;
    bottom: 0;
    left: var(--track-left);
    right: 0;
    pointer-events: none;
    background-image: linear-gradient(to right, var(--grid) 1px, transparent 1px);
    background-size: calc(100% / var(--years)) 100%;
    border-right: 1px solid var(--grid);
  }
  .axis {
    margin-top: 10px;
  }
  .axis .years {
    display: grid;
    grid-template-columns: repeat(var(--years), 1fr);
    font-size: 11px;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .axis .years span {
    min-width: 0;
    overflow: hidden;
  }
  ul,
  .axis {
    position: relative;
  }

  @media (min-width: 900px) {
    .tl {
      --track-left: calc(var(--tile) + var(--gap) + var(--label) + var(--gap));
    }
    .row {
      grid-template-columns: var(--tile) var(--label) 1fr;
    }
    .tile {
      grid-row: auto;
    }
    .axis {
      grid-template-columns: calc(var(--tile) + var(--gap) + var(--label)) 1fr;
    }
  }

  @media (max-width: 899px) {
    /* Labels sit above the bars here, so year lines would run through the text. */
    .gridlines {
      display: none;
    }
    .axis {
      grid-template-columns: var(--tile) 1fr;
    }
    .axis .years {
      font-size: 9px;
    }
  }
</style>
