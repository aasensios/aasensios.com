---
import "@fontsource-variable/schibsted-grotesk";
import { DEFAULT_STYLE, STYLE_LABELS, STYLES } from "../../lib/style";
import { site } from "../../content/site";
import { formatPeriodMonths, toYearMonth, yearsSince } from "../../lib/dates";

const now = toYearMonth(new Date());
const copy = site.copy.marketing;
const linkedin = site.links.find((l) => l.label === "LinkedIn")!;
const github = site.links.find((l) => l.label === "GitHub")!;
const toolByName = new Map(site.stack.map((t) => [t.name, t]));
const years = yearsSince(site.firstJobStart, now);
---

<div class="mk">
  <header class="bar">
    <img class="avatar" src={site.avatar} alt="" width="40" height="40" />
    <span class="name">{site.name}</span>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="copy">
        <h1>{copy.headline}</h1>
        <div class="intro">{copy.intro.map((p) => <p>{p}</p>)}</div>
        <p class="facts">{copy.facts(years)}</p>
      </div>
    </section>

    <section class="sec">
      <h2>{copy.sections.experience}</h2>
      <ul class="entries">
        {
          site.experience.map((e) => {
            const outcome = copy.outcomes[e.company];
            const achievement = copy.achievements[e.company];
            const company = copy.companies[e.company];
            const cardId = `company-${e.company.toLowerCase()}`;
            return (
              <li class="entry">

                <span class="body">
                  <span class="title">
                    {e.role} at{" "}
                    {company ? (
                      <span class="co">
                        <a
                          class="co-link"
                          href={company.url}
                          target="_blank"
                          rel="noopener"
                          aria-describedby={cardId}
                        >
                          {e.company}
                        </a>
                        <span class="co-card" id={cardId} role="tooltip">
                          <a class="co-shot" href={company.url} target="_blank" rel="noopener" tabindex="-1">
                            <img src={company.preview} alt="" width="640" height="405" loading="lazy" />
                          </a>
                        </span>
                      </span>
                    ) : (
                      e.company
                    )}
                    {e.client && ` (${e.client})`}
                  </span>
                  {outcome && (
                    <span class="outcome">
                      <b>{outcome.value}</b> {outcome.label}
                    </span>
                  )}
                  {achievement && <span class="achievement">{achievement}</span>}
                </span>
                <span class="meta">{formatPeriodMonths(e.start, e.end, now)}</span>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="sec" id="marketing-projects">
      <h2>{copy.sections.projects}</h2>
      <ul class="entries">
        {
          site.projects.map((p) => (
            <li>
              <a class="entry entry--link" href={p.repo} target="_blank" rel="noopener">
                <span class="body">
                  <span class="title">{p.title}</span>
                  <span class="desc">{p.description}</span>
                </span>
                <span class="meta">{p.year}</span>
                <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path
                    d="M4 12 12 4M5.5 4H12v6.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec">
      <h2>{copy.sections.stack}</h2>
      <div class="groups">
        {
          copy.stackGroups.map((g) => (
            <div class="group">
              <h3>{g.label}</h3>
              <ul class="parts">
                {g.tools.map((name) => {
                  const t = toolByName.get(name)!;
                  return (
                    <li>
                      <img
                        src={t.logo}
                        alt=""
                        width="18"
                        height="18"
                        class:list={{ "dark-invert": t.invertOnDark }}
                      />
                      {t.name}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }

    <div class="moods">
      <p class="moods-line">
        {copy.moodsLead}{" "}
        {
          STYLES.map((id, i) => (
            <>
              {i === 1 ? ", " : i === 2 ? " or " : ""}
              <button
                type="button"
                class="mood"
                data-preview-style={id}
                aria-pressed={id === DEFAULT_STYLE ? "true" : "false"}
              >
                {STYLE_LABELS[id]}
              </button>
            </>
          ))
        }.
      </p>
      <div class="speaker-card" aria-hidden="true">
        <div class="speaker" data-speaker data-labels={JSON.stringify(copy.glassLabels)}>
          <div class="shell">
            {Array.from({ length: 10 }, (_, i) => <span class="slice" style={`--i:${i + 1}`} />)}
            <div class="face">
              <div class="rail">
                <span class="rail-pill"></span>
                {
                  STYLES.map((id) => (
                    <span class="rail-item" data-rail-style={id} data-on={id === DEFAULT_STYLE ? "" : undefined}>
                      {STYLE_LABELS[id]}
                    </span>
                  ))
                }
              </div>
              <div class="grille">
                <div class="preview" data-preview></div>
                <span class="glass">
                  <span class="glass-label" data-glass-label></span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

    <footer class="sec end">
      <p class="sign">{site.name}</p>
      <nav class="keys" aria-label={copy.keysLabel}>
        <a class="key" href={linkedin.href} target="_blank" rel="noopener">{copy.secondaryCta}</a>
        <a class="key key--flat" href={github.href} target="_blank" rel="noopener">{copy.githubCta}</a>
      </nav>
    </footer>
  </main>

  <div class="peel" data-peel data-next="saas" data-tip={copy.peelTip(STYLE_LABELS.saas)} aria-hidden="true">
    <div class="peel-under">
      <div class="peel-page" data-peel-page></div>
      <span class="peel-label" data-peel-label></span>
    </div>
    <div class="peel-fold"><div class="peel-flap"></div></div>
  </div>
  <button type="button" class="peel-hit" data-peel-hit aria-label={copy.peelLabel}></button>
</div>

<style>
  /*
   * Appliance Catalog: matte plastic, graphite ink, one signal orange reserved for things
   * you operate. One column, with space instead of lines between sections.
   */
  .mk {
    --ground: #d6d8d6;
    --panel: #ececea;
    --panel-hi: #f6f6f4;
    --ink: #232526;
    --ink-2: #4a4d4f;
    --rule: #a3a6a3;
    --signal: #ff5a00;
    /* Focus needs 3:1 on the plastics, which the bright orange misses in light. */
    --focus: #c43d00;
    --chip: #e2e3e0;
    --cast: rgb(30 34 36 / 0.28);
    --font: "Schibsted Grotesk Variable", "Helvetica Neue", Arial, sans-serif;
    --pad: 20px;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);

    /* Speaker plastics. */
    --sp: #0f3c4b;
    --sp-hi: #1c5d6f;
    --sp-side: #082833;
    --sp-hole: #062029;
    --sp-text: #a9cdd3;
    --sp-text-on: #f2fbfb;
    --sp-glow-a: rgb(38 230 190);
    --sp-glow-b: rgb(124 92 255);
    --sp-night: #0b1d26;

    min-height: 100vh;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    .mk {
      --ground: #1b1d1e;
      --panel: #2a2c2e;
      --panel-hi: #333638;
      --ink: #ecedea;
      --ink-2: #b4b7b4;
      --rule: #4c4f51;
      --signal: #ff6a1a;
      --focus: #ff6a1a;
      --chip: #262829;
      --cast: rgb(0 0 0 / 0.5);
    }
    .mk {
    }
    .mk .dark-invert {
      filter: invert(1) hue-rotate(180deg);
    }
  }

  .mk a {
    color: inherit;
  }
  .mk ::selection {
    background: var(--signal);
    color: #111;
  }
  .mk a:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  ul,
  dl,
  dd {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Bar */
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 820px;
    margin: 0 auto;
    padding: 14px var(--pad);
  }
  .avatar {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px var(--panel),
      0 4px 10px -4px var(--cast);
  }
  .name {
    margin: 0;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px var(--pad) 48px;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  h1 {
    margin: 0 0 20px;
    font-weight: 700;
    font-size: clamp(2.25rem, 7vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  /* The intro backs the headline: two paragraphs, the first set larger. */
  .intro p {
    margin: 0;
    max-width: 32em;
    font-size: 17px;
    color: var(--ink-2);
  }
  .intro p:first-child {
    font-size: clamp(1.125rem, 2.6vw, 1.25rem);
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .intro p + p {
    margin-top: 16px;
  }
  .facts {
    margin: 16px 0 0;
    max-width: 32em;
    font-size: 17px;
    color: var(--ink-2);
  }
  .copy .keys {
    margin-top: 28px;
  }

  /*
   * The moods line closes the page: once you have read it, three underlined style names.
   * Pointing at one opens the speaker card above it with that style's page in its grille;
   * clicking switches.
   */
  .moods {
    position: relative;
    margin-top: 64px;
  }
  .moods-line {
    margin: 0;
    font-size: clamp(1.125rem, 2.6vw, 1.25rem);
    font-weight: 500;
    line-height: 1.45;
  }
  .mood {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--ink-2);
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .mood:hover {
    text-decoration-color: var(--signal);
  }
  .mood:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .speaker-card {
    position: absolute;
    left: 0;
    bottom: calc(100% + 16px);
    z-index: 20;
    width: min(380px, calc(100vw - 2 * var(--pad)));
    padding: 24px 24px 32px;
    border-radius: 32px;
    corner-shape: squircle;
    background:
      radial-gradient(80% 60% at 15% 70%, color-mix(in srgb, var(--sp-glow-a) 7%, transparent), transparent 70%),
      radial-gradient(80% 60% at 90% 80%, color-mix(in srgb, var(--sp-glow-b) 9%, transparent), transparent 70%),
      var(--sp-night);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 30px 60px -24px var(--cast);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: visibility 0s linear 160ms;
  }
  .moods:has(.mood:hover, .mood:focus-visible) .speaker-card {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  /* No hover on touch: a tap switches straight away, so the card never needs to show. */
  @media (hover: none) {
    .speaker-card {
      display: none;
    }
  }

  /*
   * The page turn: the bottom-right corner of the page curls a little. Hovering lifts it to
   * show the next style underneath; clicking turns the page into it.
   */
  @property --peel {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }
  .mk {
    position: relative;
  }
  .peel {
    --peel: 46px;
    position: absolute;
    right: 0;
    bottom: 0;
    width: 220px;
    height: 220px;
    pointer-events: none;
  }
  .mk:has(.peel-hit:is(:hover, :focus-visible)) .peel {
    --peel: 170px;
  }
  .peel-under {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(100% calc(100% - var(--peel)), 100% 100%, calc(100% - var(--peel)) 100%);
    background: #fff;
  }
  /* The next style's page lies under the corner, its top-left tucked into the fold. */
  .peel-page {
    position: absolute;
    left: calc(100% - var(--peel));
    top: calc(100% - var(--peel));
    width: 1280px;
    height: 900px;
    overflow: hidden;
    transform: scale(0.3);
    transform-origin: 0 0;
  }
  .peel-page :global(.preview-page) {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    pointer-events: none;
  }
  /* The folded flap: the paper's back, darkening toward the fold, casting onto the page. */
  .peel-fold {
    position: absolute;
    inset: 0;
    filter: drop-shadow(-4px -4px 8px rgb(0 0 0 / 0.22));
  }
  .peel-flap {
    position: absolute;
    inset: 0;
    clip-path: polygon(
      calc(100% - var(--peel)) 100%,
      100% calc(100% - var(--peel)),
      calc(100% - var(--peel)) calc(100% - var(--peel))
    );
    background: linear-gradient(
      135deg,
      #fbfbfa calc(100% - var(--peel) * 1.2),
      #e7e9e6 calc(100% - var(--peel) * 0.75),
      #c3c6c3 calc(100% - var(--peel) * 0.5)
    );
  }
  .peel-label {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #15181a;
    color: #fff;
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
    opacity: 0;
  }
  .mk:has(.peel-hit:is(:hover, :focus-visible)) .peel-label {
    opacity: 1;
  }
  .peel-hit {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }
  .mk:has(.peel-hit:hover) .peel-hit {
    width: 180px;
    height: 180px;
  }
  .peel-hit:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -6px;
  }

  /*
   * The speaker: a moulded squircle with a button rail that picks a style to
   * preview, and a grille the chosen style's page shows through. Static 3D: a slight tilt
   * reveals its depth, built from stacked slices behind the face.
   */
  .speaker {
    grid-area: speaker;
    position: relative;
    justify-self: center;
    width: min(100%, 320px);
    perspective: 1100px;
    filter: drop-shadow(-8px 8px 20px color-mix(in srgb, var(--sp-glow-a) 7%, transparent))
      drop-shadow(10px 14px 24px color-mix(in srgb, var(--sp-glow-b) 9%, transparent))
      drop-shadow(0 18px 22px var(--cast));
  }
  .shell {
    position: relative;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(8deg) rotateY(-14deg);
  }
  .slice {
    position: absolute;
    inset: 0;
    border-radius: 34%;
    corner-shape: squircle;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--sp-glow-a) 28%, var(--sp-side)),
      var(--sp-side) 28%,
      var(--sp-side) 72%,
      color-mix(in srgb, var(--sp-glow-b) 32%, var(--sp-side))
    );
    transform: translateZ(calc(var(--i) * -2.6px));
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 6%;
    padding: 8%;
    border-radius: 34%;
    corner-shape: squircle;
    background: radial-gradient(130% 110% at 28% 12%, var(--sp-hi), var(--sp) 62%);
    /* Rim light: teal from the left, violet from the right, like a studio product shot. */
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.14),
      inset 10px 0 22px -18px color-mix(in srgb, var(--sp-glow-a) 30%, transparent),
      inset -10px 0 22px -16px color-mix(in srgb, var(--sp-glow-b) 34%, transparent),
      inset 0 -8px 16px rgb(0 0 0 / 0.35);
  }
  .rail {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 24px;
    corner-shape: squircle;
    background: rgb(0 0 0 / 0.3);
    box-shadow:
      inset 0 2px 4px rgb(0 0 0 / 0.5),
      0 1px 0 rgb(255 255 255 / 0.08);
  }
  .rail-item {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    display: grid;
    place-items: center;
    min-height: 40px;
    padding: 0 10px;
    color: var(--sp-text);
    font: 600 13px/1 var(--font);
  }
  .rail-item[data-on] {
    color: var(--sp-text-on);
  }
  /* One pill slides between the labels; speaker.ts sets its x and width from the pressed one. */
  .rail-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--pill-w, 0);
    translate: var(--pill-x, 0) 0;
    border-radius: 20px;
    corner-shape: squircle;
    background: rgb(255 255 255 / 0.12);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
    pointer-events: none;
  }
  .grille {
    position: relative;
    overflow: hidden;
    border-radius: 28%;
    corner-shape: squircle;
    background:
      radial-gradient(circle, var(--sp-hole) 1.4px, transparent 1.9px) 0 0 / 6px 6px,
      var(--sp);
  }
  /* The picked style's real page, always visible in the grille. */
  .preview {
    position: absolute;
    inset: 0;
  }
  .preview :global(.preview-page) {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    transform-origin: 0 0;
    pointer-events: none;
  }
  /*
   * The grille itself is the button: hovering or focusing it shows where it will take you,
   * pressing it switches.
   */
  .glass {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    color: var(--sp-text-on);
  }
  .glass-label {
    padding: 10px 16px;
    border-radius: 999px;
    background: rgb(6 32 41 / 0.55);
    font: 600 17px/1 var(--font);
    letter-spacing: -0.01em;
    opacity: 0;
    scale: 0.96;
  }
  /* The label always says what the preview is: where a click goes, or that you are here. */
  .glass-label:not(:empty) {
    opacity: 1;
    scale: 1;
  }
  /* Keys: LinkedIn is the raised key; GitHub sits flat beside it as the quieter route. */
  /* An idle breath on the page corner, so a reader notices it can be turned. */
  @keyframes peel-breathe {
    0%,
    80%,
    100% {
      --peel: 46px;
    }
    88% {
      --peel: 64px;
    }
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .key {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    background: linear-gradient(180deg, var(--panel-hi), var(--chip));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 0 0 1px var(--rule),
      0 3px 0 var(--rule),
      0 8px 14px -8px var(--cast);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }
  /*
   * The raised key on hover: it rises off the plastic (taller lip, deeper shadow) while a
   * soft highlight sweeps across its face, like light catching a moulded button.
   */
  .key:not(.key--flat) {
    background:
      linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.55) 50%, transparent 62%) 130% 0 /
        260% 100% no-repeat,
      linear-gradient(180deg, var(--panel-hi), var(--chip));
  }
  .key:not(.key--flat):hover {
    translate: 0 -2px;
    background-position:
      -30% 0,
      0 0;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 0 0 1px var(--ink-2),
      0 5px 0 var(--rule),
      0 16px 22px -10px var(--cast);
  }
  .key:active {
    translate: 0 2px;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.3),
      0 0 0 1px var(--rule),
      0 1px 0 var(--rule);
  }
  .key--flat {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rule);
    font-weight: 500;
  }
  .key--flat:hover {
    box-shadow: inset 0 0 0 1px var(--ink-2);
  }
  .key--flat:active {
    translate: 0 1px;
    box-shadow: inset 0 0 0 1px var(--ink-2);
  }

  /* Sections: heading over content, separated by space. */
  .sec {
    display: grid;
    gap: 16px;
    margin-top: 64px;
  }
  h2 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  /* The only drawn divider on the page: a hairline between list rows. */
  .entries > li {
    border-bottom: 1px solid var(--rule);
  }
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "body"
      "meta";
    align-items: center;
    column-gap: 16px;
    row-gap: 2px;
    padding: 14px 0;
    text-decoration: none;
  }
  .body {
    grid-area: body;
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .title {
    font-weight: 600;
    font-size: 17px;
  }
  .outcome,
  .achievement,
  .desc {
    font-size: 15px;
