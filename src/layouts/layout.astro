---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
/* A static 1200×630 card in public/og.png; bump ?v= after replacing it so link previews refresh. */
const ogImage = new URL("/og.png?v=1", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alejandro Asensio: I make screens you can leave." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-light.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/averia-serif-libre-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.dataset.js = "";
        const setDay = () => {
          root.dataset.day = String(new Date().getDay());
          const midnight = new Date();
          midnight.setHours(24, 0, 0, 0);
          clearTimeout(setDay.timer);
          setDay.timer = setTimeout(setDay, midnight.getTime() - Date.now() + 1000);
        };
        setDay();
        /* Timers stall while a laptop sleeps, so check again whenever the tab comes back. */
        addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") setDay();
        });
        const prefersDark = matchMedia("(prefers-color-scheme: dark)");
        let picked = false;
        const apply = (theme) => {
          root.dataset.theme = theme;
          for (const button of document.querySelectorAll("[data-theme-toggle]")) {
            button.setAttribute("aria-pressed", String(theme === "dark"));
          }
        };
        apply(prefersDark.matches ? "dark" : "light");
        prefersDark.addEventListener("change", (event) => {
          if (!picked) apply(event.matches ? "dark" : "light");
        });
        addEventListener("DOMContentLoaded", () => apply(root.dataset.theme));
        addEventListener("click", (event) => {
          const button = event.target.closest("[data-theme-toggle]");
          if (!button) return;
          picked = true;
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (document.startViewTransition && !still) {
            document.startViewTransition(() => apply(next));
          } else {
            apply(next);
          }
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
